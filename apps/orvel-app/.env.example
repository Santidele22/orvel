# Names-only manifest for orvel-app. Every entry is a NAME with an empty value.
# Production values are set with `wrangler secret put` / Cloudflare secrets, never committed.
# Local development values belong in `.dev.vars`, which is git-ignored. No real value may ever appear here.
# database
DATABASE_URL=
# auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# email
RESEND_API_KEY=
EMAIL_FROM=
# object storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# cache and jobs
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
# web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# observability
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
# app URLs
PUBLIC_APP_URL=
PUBLIC_LANDING_URL=
