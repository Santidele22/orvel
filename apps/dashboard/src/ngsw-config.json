{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/icons/*.png",
          "/manifest.webmanifest"
        ]
      }
    },
    {
      "name": "app-lazy",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.js",
          "/**/*.css",
          "/**/*.html"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.woff2",
          "/**/*.woff",
          "/**/*.ttf",
          "/**/*.svg",
          "/**/*.ico",
          "/**/*.png",
          "/**/*.webp",
          "/**/*.jpg",
          "/**/*.jpeg",
          "/**/*.gif"
        ]
      }
    }
  ]
}
