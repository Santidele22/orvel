---
import "../styles/global.css";
import "remixicon/fonts/remixicon.css";
import Preloader from "../components/organisms/Preloader.astro";

interface Props {
    title: string;
    showPreloader?: boolean;
}

const { title, showPreloader = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Gestioná tus turnos y clientes con la fluidez que merecés. Orvel es el espacio digital diseñado para potenciar tu negocio."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO y Open Graph / Redes Sociales -->
        <meta name="robots" content="index, follow" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content="Gestioná tus turnos y clientes con la fluidez que merecés. Orvel es el espacio digital diseñado para potenciar tu negocio." />
        <meta property="og:image" content="/logo.png" />
        <meta property="og:site_name" content="Orvel" />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content="Gestioná tus turnos y clientes con la fluidez que merecés. Orvel es el espacio digital diseñado para potenciar tu negocio." />
        <meta name="twitter:image" content="/logo.png" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
    </head>
    <body class="bg-bg-primary text-text-primary antialiased">
        {showPreloader && <Preloader />}
        <slot />

        <script>
            import { initScrollReveal } from '../lib/scroll-reveal';
            initScrollReveal();
        </script>
    </body>
</html>
