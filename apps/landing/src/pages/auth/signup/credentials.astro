---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Registrá tu cuenta" showPreloader={false}>
  <main class="flex min-h-screen w-full bg-bg-primary">
    <!-- Left Side: Imagery -->
    <section class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-bg-secondary flex-col justify-end p-12 lg:p-24">
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-bg-primary via-bg-primary/20 to-transparent opacity-90"></div>
      <img src="/banner3.png" alt="Orvel Dashboard" class="absolute inset-0 w-full h-full object-cover scale-110 blur-[1px] opacity-70" />
      
      <div class="relative z-20 space-y-4">
        <div class="inline-block px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-[10px] font-bold tracking-widest uppercase text-primary mb-2 shadow-sm">Paso 2 de 3</div>
        <h2 class="text-4xl lg:text-5xl font-headline font-bold text-text-primary leading-[1.1] max-w-md">
          Estás a un paso de automatizar tu negocio.
        </h2>
        <p class="text-text-secondary text-lg font-body max-w-sm">
            Creá tu perfil y configurá tu espacio de trabajo profesional.
        </p>
      </div>
    </section>

    <!-- Right Side: Credentials Form -->
    <section class="w-full lg:w-1/2 flex flex-col justify-center px-8 sm:px-16 lg:px-24 relative z-10">
      <div class="max-w-md w-full mx-auto md:mx-0 lg:ml-0">
        
        <header class="mb-10">
          <!-- Step indicator -->
          <div class="flex items-center gap-4 mb-8">
            <a href="/auth/signup/plan" class="w-8 h-8 rounded-full border border-primary bg-primary/10 flex items-center justify-center text-xs text-primary font-bold">1</a>
            <div class="w-8 h-[2px] bg-primary"></div>
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-xs text-on-secondary font-bold shadow-lg shadow-primary/20">2</div>
            <div class="w-8 h-[2px] bg-border"></div>
            <div class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-xs text-text-secondary">3</div>
          </div>

          <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tighter text-text-primary mb-2 leading-[1.1]">
            Tus datos.
          </h1>
          <p class="text-text-secondary text-base font-body">
            Configurá tus credenciales de acceso.
          </p>
        </header>

        <form id="credentialsForm" class="space-y-6" novalidate>
          <div class="group">
            <label for="nombre" class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Nombre</label>
            <input id="nombre" name="nombre" type="text" autocomplete="given-name" required class="input" placeholder="Tu nombre" />
            <p id="error-nombre" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label for="apellido" class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Apellido</label>
            <input id="apellido" name="apellido" type="text" autocomplete="family-name" required class="input" placeholder="Tu apellido" />
            <p id="error-apellido" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Nombre del Negocio</label>
            <input id="negocioNombre" name="negocioNombre" type="text" autocomplete="off" required class="input" placeholder="Tu marca o local" />
            <p id="error-negocioNombre" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Teléfono Argentina</label>
            <div class="grid grid-cols-[0.75fr_1fr] gap-3">
              <div>
                <label for="telefonoCaracteristica" class="sr-only">Característica o código de área</label>
                <input id="telefonoCaracteristica" name="telefonoCaracteristica" type="tel" inputmode="numeric" autocomplete="tel-area-code" required class="input" placeholder="Código de área" aria-describedby="telefonoHelp error-telefonoCaracteristica" />
                <p id="error-telefonoCaracteristica" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
              </div>
              <div>
                <label for="telefonoNumero" class="sr-only">Número local</label>
                <input id="telefonoNumero" name="telefonoNumero" type="tel" inputmode="numeric" autocomplete="tel-local" required class="input" placeholder="Número local" aria-describedby="telefonoHelp error-telefonoNumero" />
                <p id="error-telefonoNumero" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
              </div>
            </div>
            <p id="telefonoHelp" class="mt-2 text-[10px] text-text-secondary/70 ml-1">Solo números, sin 0, 15, espacios ni guiones. Para característica 294, el número local puede tener 6 o 7 dígitos.</p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Email</label>
            <input id="email" name="email" type="email" autocomplete="off" required class="input" placeholder="ejemplo@negocio.com" />
            <p id="error-email" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div id="passwordFields" class="grid grid-cols-2 gap-4">
            <div class="group">
              <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Contraseña</label>
              <input id="password" name="password" type="password" autocomplete="new-password" required class="input" placeholder="•••••••••" />
              <p id="error-password" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
            </div>
            <div class="group">
              <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Confirmar</label>
              <input id="confirmPassword" name="confirm" type="password" autocomplete="new-password" required class="input" placeholder="•••••••••" />
              <p id="error-confirm" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
            </div>
          </div>

          <p id="signupError" class="hidden text-xs text-error font-medium" aria-live="polite"></p>

          <footer class="pt-8 flex items-center justify-between">
            <a id="backLink" href="/auth/signup/plan" class="text-[10px] uppercase tracking-[0.2em] text-text-secondary hover:text-text-primary transition-colors flex items-center gap-2">
              <span>←</span> Atrás
            </a>
            <button type="submit" disabled class="btn btn-primary py-4 px-10 rounded-full uppercase tracking-widest text-xs shadow-xl shadow-primary/20 disabled:cursor-not-allowed disabled:opacity-50">
              Continuar
            </button>
          </footer>
        </form>

        <p class="mt-12 text-[10px] text-text-secondary/50 font-body leading-relaxed uppercase tracking-wider">
          Al continuar, aceptás nuestros términos de servicio y políticas de privacidad. Tus datos están protegidos y cifrados.
        </p>

        <div
          id="create-account-redirect-notice"
          data-notice-type="missing_plan"
          data-notice-context="create_account"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/45 px-4 py-6 text-blue-900 backdrop-blur-sm [&:not(.hidden)]:flex"
          role="dialog"
          aria-live="polite"
          aria-modal="true"
          aria-hidden="true"
          aria-labelledby="create-account-redirect-notice-title"
          aria-describedby="create-account-redirect-notice-description"
        >
          <div class="w-full max-w-[440px] overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-xl">
            <div class="space-y-4 p-6 sm:p-8">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600 shadow-sm">
                <i class="ri-information-line text-2xl" aria-hidden="true"></i>
              </div>
              <div class="space-y-2">
                <h2 id="create-account-redirect-notice-title" tabindex="-1" class="text-xl font-headline font-black text-blue-900 outline-none">
                  Elegí un plan para continuar
                </h2>
                <p id="create-account-redirect-notice-description" class="text-sm leading-6 text-blue-800">
                  Ya tenemos tus datos de acceso. Para crear tu cuenta, seleccioná un plan. Si elegís un plan pago, te llevaremos a Mercado Pago.
                </p>
                <p class="text-xs font-bold uppercase tracking-widest text-blue-700">
                  Redirigiendo en aproximadamente 5 segundos…
                </p>
              </div>
              <button
                id="create-account-redirect-continue-now"
                type="button"
                class="w-full rounded-full bg-blue-700 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              >
                Continuar ahora
              </button>
            </div>
            <div class="h-1 w-full bg-blue-100">
              <div class="h-full w-full origin-left bg-blue-600 motion-safe:animate-[redirect-notice-progress_5s_linear_forwards]"></div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
</Layout>

<script>
  import { initSignupCredentialsPage } from '../../../lib/signup-credentials-page-controller';
  initSignupCredentialsPage(import.meta.env);
</script>

<!-- Validation remains Zod-backed from '../../../lib/signup-credentials-validation' via the page controller. -->
