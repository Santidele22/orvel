---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Registrá tu cuenta">
  <main class="flex min-h-screen w-full bg-bg-primary">
    <!-- Left Side: Imagery -->
    <section class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-bg-secondary flex-col justify-end p-12 lg:p-24">
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-bg-primary via-bg-primary/20 to-transparent opacity-90"></div>
      <img src="/banner3.png" alt="Orvel Dashboard" class="absolute inset-0 w-full h-full object-cover scale-110 blur-[1px] opacity-70" />
      
      <div class="relative z-20 space-y-4">
        <div class="inline-block px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-[10px] font-bold tracking-widest uppercase text-primary mb-2 shadow-sm">Paso 2 de 3</div>
        <h2 class="text-4xl lg:text-5xl font-headline font-bold text-text-primary leading-[1.1] max-w-md">
          Estás a un paso de automatizar tu negocio.
        </h2>
        <p class="text-text-secondary text-lg font-body max-w-sm">
            Creá tu perfil y configurá tu espacio de trabajo profesional.
        </p>
      </div>
    </section>

    <!-- Right Side: Credentials Form -->
    <section class="w-full lg:w-1/2 flex flex-col justify-center px-8 sm:px-16 lg:px-24 relative z-10">
      <div class="max-w-md w-full mx-auto md:mx-0 lg:ml-0">
        
        <header class="mb-10">
          <!-- Step indicator -->
          <div class="flex items-center gap-4 mb-8">
            <a href="/auth/signup/plan" class="w-8 h-8 rounded-full border border-primary bg-primary/10 flex items-center justify-center text-xs text-primary font-bold">1</a>
            <div class="w-8 h-[2px] bg-primary"></div>
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-xs text-on-secondary font-bold shadow-lg shadow-primary/20">2</div>
            <div class="w-8 h-[2px] bg-border"></div>
            <div class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-xs text-text-secondary">3</div>
          </div>

          <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tighter text-text-primary mb-2 leading-[1.1]">
            Tus datos.
          </h1>
          <p class="text-text-secondary text-base font-body">
            Configurá tus credenciales de acceso.
          </p>
        </header>

        <form id="credentialsForm" class="space-y-6" novalidate>
          <div class="group">
            <label for="nombre" class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Nombre</label>
            <input id="nombre" name="nombre" type="text" autocomplete="given-name" required class="input" placeholder="Tu nombre" />
            <p id="error-nombre" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label for="apellido" class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Apellido</label>
            <input id="apellido" name="apellido" type="text" autocomplete="family-name" required class="input" placeholder="Tu apellido" />
            <p id="error-apellido" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Nombre del Negocio</label>
            <input id="negocioNombre" name="negocioNombre" type="text" autocomplete="off" required class="input" placeholder="Tu marca o local" />
            <p id="error-negocioNombre" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Teléfono</label>
            <input id="telefono" name="telefono" type="tel" autocomplete="off" required class="input" placeholder="+54 9 11 ..." />
            <p id="error-telefono" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Email</label>
            <input id="email" name="email" type="email" autocomplete="off" required class="input" placeholder="ejemplo@negocio.com" />
            <p id="error-email" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div id="passwordFields" class="grid grid-cols-2 gap-4">
            <div class="group">
              <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Contraseña</label>
              <input id="password" name="password" type="password" autocomplete="new-password" required class="input" placeholder="•••••••••" />
              <p id="error-password" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
            </div>
            <div class="group">
              <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Confirmar</label>
              <input id="confirmPassword" name="confirm" type="password" autocomplete="new-password" required class="input" placeholder="•••••••••" />
              <p id="error-confirm" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
            </div>
          </div>

          <p id="signupError" class="hidden text-xs text-error font-medium" aria-live="polite"></p>

          <footer class="pt-8 flex items-center justify-between">
            <a id="backLink" href="/auth/signup/plan" class="text-[10px] uppercase tracking-[0.2em] text-text-secondary hover:text-text-primary transition-colors flex items-center gap-2">
              <span>←</span> Atrás
            </a>
            <button type="submit" class="btn btn-primary py-4 px-10 rounded-full uppercase tracking-widest text-xs shadow-xl shadow-primary/20">
              Continuar
            </button>
          </footer>
        </form>

        <p class="mt-12 text-[10px] text-text-secondary/50 font-body leading-relaxed uppercase tracking-wider">
          Al continuar, aceptás nuestros términos de servicio y políticas de privacidad. Tus datos están protegidos y cifrados.
        </p>

        <div
          id="create-account-redirect-notice"
          data-notice-type="missing_plan"
          data-notice-context="create_account"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/45 px-4 py-6 text-blue-900 backdrop-blur-sm [&:not(.hidden)]:flex"
          role="dialog"
          aria-live="polite"
          aria-modal="true"
          aria-hidden="true"
          aria-labelledby="create-account-redirect-notice-title"
          aria-describedby="create-account-redirect-notice-description"
        >
          <div class="w-full max-w-[440px] overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-xl">
            <div class="space-y-4 p-6 sm:p-8">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600 shadow-sm">
                <i class="ri-information-line text-2xl" aria-hidden="true"></i>
              </div>
              <div class="space-y-2">
                <h2 id="create-account-redirect-notice-title" tabindex="-1" class="text-xl font-headline font-black text-blue-900 outline-none">
                  Elegí un plan para continuar
                </h2>
                <p id="create-account-redirect-notice-description" class="text-sm leading-6 text-blue-800">
                  Ya tenemos tus datos de acceso. Para crear tu cuenta, seleccioná un plan. Si elegís un plan pago, te llevaremos a Mercado Pago.
                </p>
                <p class="text-xs font-bold uppercase tracking-widest text-blue-700">
                  Redirigiendo en aproximadamente 5 segundos…
                </p>
              </div>
              <button
                id="create-account-redirect-continue-now"
                type="button"
                class="w-full rounded-full bg-blue-700 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              >
                Continuar ahora
              </button>
            </div>
            <div class="h-1 w-full bg-blue-100">
              <div class="h-full w-full origin-left bg-blue-600 motion-safe:animate-[redirect-notice-progress_5s_linear_forwards]"></div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
</Layout>

<script>
  import { SIGNUP_STORAGE_KEYS } from '../../../lib/browser-storage-keys';

  if (typeof window !== 'undefined') {
    const searchParams = new URLSearchParams(window.location.search);
    const VALID_SIGNUP_PLANS = ['FREE', 'STARTER', 'GROWTH', 'PRO'] as const;
    const normalizeSignupPlan = (rawPlan: string | null) => rawPlan?.trim().toUpperCase() ?? '';
    const isValidSignupPlan = (rawPlan: string | null) => VALID_SIGNUP_PLANS.includes(normalizeSignupPlan(rawPlan) as typeof VALID_SIGNUP_PLANS[number]);
    const missingPlanRedirectUrl = '/auth/signup/plan?reason=missing_plan&intent=create_account';
    const invalidPlanRedirectUrl = '/auth/signup/plan?reason=invalid_plan&intent=create_account';
    let planSelectionRedirectUrl = missingPlanRedirectUrl;
    let redirectNoticeTimeout: ReturnType<typeof setTimeout> | undefined;
    const openRedirectNotice = () => {
      const redirectNotice = document.getElementById('create-account-redirect-notice');
      redirectNotice?.classList.remove('hidden');
      redirectNotice?.setAttribute('aria-hidden', 'false');
      document.getElementById('create-account-redirect-notice-title')?.focus();
      const noticeCopy = 'Primero elegí un plan';
      redirectNotice?.setAttribute('aria-label', noticeCopy);
      window.clearTimeout(redirectNoticeTimeout);
      redirectNoticeTimeout = setTimeout(() => {
        window.location.href = planSelectionRedirectUrl;
      }, 5000);
    };
    document.getElementById('create-account-redirect-continue-now')?.addEventListener('click', () => {
      window.clearTimeout(redirectNoticeTimeout);
      window.location.href = planSelectionRedirectUrl;
    });
    const redirectToPlanSelection = (reason: 'missing_plan' | 'invalid_plan') => {
      sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.plan);
      sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.billing);
      planSelectionRedirectUrl = reason === 'missing_plan' ? missingPlanRedirectUrl : invalidPlanRedirectUrl;
      openRedirectNotice();
    };

    const explicitPlan = searchParams.get('plan');
    const selectedPlan = explicitPlan;
    const hasValidSignupPlan = Boolean(explicitPlan?.trim()) && isValidSignupPlan(explicitPlan);

    if (!explicitPlan?.trim()) {
      sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.plan);
      sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.billing);
    } else if (!isValidSignupPlan(explicitPlan)) {
      redirectToPlanSelection('invalid_plan');
    }
    const plan = hasValidSignupPlan ? normalizeSignupPlan(selectedPlan) : '';
    const isExplicitFreePlan = normalizeSignupPlan(explicitPlan) === 'FREE';
    const isPaidPlan = plan !== 'FREE';
    const normalizeBillingPeriod = (raw: string | null) => {
      const normalized = raw?.trim().toLowerCase();
      return normalized === 'quarterly' || normalized === 'annual' ? normalized : 'monthly';
    };
    const billing = normalizeBillingPeriod(isExplicitFreePlan ? searchParams.get('billing') : searchParams.get('billing') || sessionStorage.getItem(SIGNUP_STORAGE_KEYS.billing));
    if (hasValidSignupPlan && (isExplicitFreePlan || plan === 'FREE')) {
      sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent);
    }
    if (hasValidSignupPlan) {
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.plan, plan);
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.billing, billing);
    }

    const passwordFields = document.getElementById('passwordFields');
    const passwordInput = document.getElementById('password') as HTMLInputElement | null;
    const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
    if (hasValidSignupPlan && isPaidPlan) {
      passwordFields?.classList.add('hidden');
      passwordInput?.removeAttribute('required');
      confirmPasswordInput?.removeAttribute('required');
    }

    const backLink = document.getElementById('backLink') as HTMLAnchorElement;
    if (backLink) {
      backLink.href = hasValidSignupPlan
        ? `/auth/signup/plan?plan=${encodeURIComponent(plan)}&billing=${encodeURIComponent(billing)}`
        : missingPlanRedirectUrl;
    }

    // Pre-fill email from modal if available
    // PII is intentionally not restored from browser storage.

    // --- Validation Engine ---
    const form = document.getElementById('credentialsForm') as HTMLFormElement;

    const validators = {
      nombre: (val: string) => {
        if (!val) return 'El nombre es requerido';
        if (val.trim().length < 2) return 'El nombre debe tener al menos 2 caracteres';
        return '';
      },
      apellido: (val: string) => {
        if (!val) return 'El apellido es requerido';
        if (val.trim().length < 2) return 'El apellido debe tener al menos 2 caracteres';
        return '';
      },
      negocioNombre: (val: string) => {
        if (!val) return 'El nombre del negocio es requerido';
        if (val.length < 3) return 'Debe tener al menos 3 caracteres';
        return '';
      },
      telefono: (val: string) => {
        if (!val) return 'El teléfono es requerido';
        const phoneRegex = /^[+]?[(]?[0-9]{3}[)]?[-\s.]?[0-9]{3}[-\s.]?[0-9]{4,6}$/;
        if (!phoneRegex.test(val.replace(/\s/g, ''))) return 'Formato de teléfono inválido';
        return '';
      },
      email: (val: string) => {
        if (!val) return 'El email es requerido';
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(val)) return 'Ingresá un email válido';
        return '';
      },
      password: (val: string) => {
        if (isPaidPlan) return '';
        if (!val) return 'La contraseña es requerida';
        if (val.length < 8) return 'Mínimo 8 caracteres';
        return '';
      },
      confirm: (val: string, allVals: any) => {
        if (isPaidPlan) return '';
        if (!val) return 'Confirmá tu contraseña';
        if (val !== allVals.password) return 'Las contraseñas no coinciden';
        return '';
      }
    };

    const validateField = (input: HTMLInputElement) => {
      const fieldName = input.name as keyof typeof validators;
      const validator = validators[fieldName];
      if (!validator) return true;

      const allVals = {
        password: (document.getElementById('password') as HTMLInputElement)?.value
      };

      const errorMsg = validator(input.value, allVals);
      const errorEl = document.getElementById(`error-${fieldName === 'confirm' ? 'confirm' : fieldName}`);
      
      if (errorMsg) {
        if (errorEl) {
          errorEl.textContent = errorMsg;
          errorEl.classList.remove('hidden');
        }
        input.classList.add('border-error', 'bg-error/5');
        return false;
      } else {
        if (errorEl) {
          errorEl.classList.add('hidden');
        }
        input.classList.remove('border-error', 'bg-error/5');
        return true;
      }
    };

    const validateForm = () => {
      const inputs = form.querySelectorAll('input');
      let isValid = true;
      inputs.forEach(input => {
        if (!validateField(input)) isValid = false;
      });
      return isValid;
    };

    const validateNonSensitiveCredentials = (fields = ['nombre', 'apellido', 'negocioNombre', 'telefono', 'email']) => {
      let isValid = true;
      fields.forEach((field) => {
        const input = form.querySelector<HTMLInputElement>(`input[name="${field}"]`);
        if (input && !validateField(input)) isValid = false;
      });
      return isValid;
    };

    const createProtectedPendingSignupIntent = async (values: {
      email: string;
      first_name: string;
      last_name: string;
      business_name: string;
      phone: string;
    }) => {
      const protectionResponse = await fetch('/api/signup/pending-intent/protect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(values)
      });
      const protectionResult = await protectionResponse.json().catch(() => null);
      if (!protectionResponse.ok || !protectionResult?.protected_pending_signup_intent) {
        throw new Error('pending_signup_protection_failed');
      }
      return protectionResult.protected_pending_signup_intent;
    };

    form.querySelectorAll('input').forEach(input => {
      input.addEventListener('input', () => validateField(input));
      input.addEventListener('blur', () => validateField(input));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const errorEl = document.getElementById('signupError');
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }

      if (!hasValidSignupPlan) {
        const credentialsFirstRequiredFields = ['nombre', 'apellido', 'negocioNombre', 'telefono', 'email'];
        const credentialsFirstPlanUrl = '/auth/signup/plan?reason=missing_plan&intent=create_account';
        planSelectionRedirectUrl = credentialsFirstPlanUrl;
        if (!validateNonSensitiveCredentials(credentialsFirstRequiredFields)) {
          return;
        }

        const nombre = (form.querySelector<HTMLInputElement>('input[name="nombre"]')?.value ?? '').trim();
        const apellido = (form.querySelector<HTMLInputElement>('input[name="apellido"]')?.value ?? '').trim();
        const negocioNombre = (form.querySelector<HTMLInputElement>('input[name="negocioNombre"]')?.value ?? '').trim();
        const telefono = (form.querySelector<HTMLInputElement>('input[name="telefono"]')?.value ?? '').trim();
        const email = (form.querySelector<HTMLInputElement>('input[name="email"]')?.value ?? '').trim();

        try {
          if (button) {
            button.disabled = true;
            button.textContent = 'Protegiendo datos...';
          }
          const protectedSignup = await createProtectedPendingSignupIntent({
            email,
            first_name: nombre,
            last_name: apellido,
            business_name: negocioNombre,
            phone: telefono
          });
          sessionStorage.setItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent, JSON.stringify({
            email_encrypted: protectedSignup.email_encrypted,
            email_hmac: protectedSignup.email_hmac,
            first_name_encrypted: protectedSignup.first_name_encrypted,
            first_name_hmac: protectedSignup.first_name_hmac,
            last_name_encrypted: protectedSignup.last_name_encrypted,
            last_name_hmac: protectedSignup.last_name_hmac,
            business_name_encrypted: protectedSignup.business_name_encrypted,
            business_name_hmac: protectedSignup.business_name_hmac,
            phone_encrypted: protectedSignup.phone_encrypted,
            phone_hmac: protectedSignup.phone_hmac,
            pii_crypto_version: protectedSignup.pii_crypto_version
          }));
          redirectToPlanSelection(explicitPlan?.trim() ? 'invalid_plan' : 'missing_plan');
        } catch {
          if (button) {
            button.disabled = false;
            button.textContent = 'Continuar';
          }
          if (errorEl) {
            errorEl.textContent = 'No pudimos proteger tus datos. Reintentá en unos segundos.';
            errorEl.classList.remove('hidden');
          }
        }
        return;
      }
      
      if (!validateForm()) {
        return;
      }

      const nombre = (form.querySelector<HTMLInputElement>('input[name="nombre"]')?.value ?? '').trim();
      const apellido = (form.querySelector<HTMLInputElement>('input[name="apellido"]')?.value ?? '').trim();
      const negocioNombre = (form.querySelector<HTMLInputElement>('input[name="negocioNombre"]')?.value ?? '').trim();
      const telefono = (form.querySelector<HTMLInputElement>('input[name="telefono"]')?.value ?? '').trim();
      const email = (form.querySelector<HTMLInputElement>('input[name="email"]')?.value ?? '').trim();
      const password = isPaidPlan ? '' : (form.querySelector<HTMLInputElement>('input[name="password"]')?.value ?? '');

      if (!button) return;

      button.disabled = true;
      button.textContent = 'Procesando...';

      // Only plan metadata is persisted in browser storage. Signup PII stays transient.
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.plan, plan);
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.billing, billing);

      const buildDashboardOnboardingUrl = () => {
        const configuredDashboardOrigin = import.meta.env.PUBLIC_DASHBOARD_URL?.trim();
        const dashboardOrigin = configuredDashboardOrigin
          || (window.location.hostname === 'localhost' && window.location.port === '3000'
            ? window.location.origin
            : 'http://localhost:4200');
        const onboardingUrl = new URL('/auth/onboarding', dashboardOrigin);
        onboardingUrl.searchParams.set('onboarding_required', 'true');
        onboardingUrl.searchParams.set('returnTo', '/dashboard/inicio');
        onboardingUrl.searchParams.set('plan', plan);
        onboardingUrl.searchParams.set('billing', billing);
        return onboardingUrl.toString();
      };

      if (!isPaidPlan) {
        const nextStep = buildDashboardOnboardingUrl();
        const { createSupabaseSignupAdapterFromEnv, signupWithProvider } = await import('../../../lib/auth-provider');
        const supabaseSignup = createSupabaseSignupAdapterFromEnv({
          SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
          SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY
        });

        const signupResult = await signupWithProvider({
          attempt: {
            nombre,
            apellido,
            negocioNombre,
            tipoNegocio: 'pendiente',
            telefono,
            email,
            password,
            plan,
            returnTo: nextStep
          },
          supabaseSignup
        });

        if (!signupResult.ok) {
          button.disabled = false;
          button.textContent = 'Continuar';
          if (errorEl) {
            errorEl.textContent = signupResult.error || 'No pudimos crear tu cuenta. Reintentá en unos segundos.';
            errorEl.classList.remove('hidden');
          }
          return;
        }

        window.location.href = nextStep;
        return;
      }

      let protectedSignup;
      try {
        protectedSignup = await createProtectedPendingSignupIntent({
          email,
          first_name: nombre,
          last_name: apellido,
          business_name: negocioNombre,
          phone: telefono
        });
      } catch {
        button.disabled = false;
        button.textContent = 'Continuar';
        if (errorEl) {
          errorEl.textContent = 'No pudimos proteger tus datos para iniciar el pago. Reintentá en unos segundos.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      const pendingSignupIntent = {
        email_encrypted: protectedSignup.email_encrypted,
        email_hmac: protectedSignup.email_hmac,
        first_name_encrypted: protectedSignup.first_name_encrypted,
        first_name_hmac: protectedSignup.first_name_hmac,
        last_name_encrypted: protectedSignup.last_name_encrypted,
        last_name_hmac: protectedSignup.last_name_hmac,
        business_name_encrypted: protectedSignup.business_name_encrypted,
        business_name_hmac: protectedSignup.business_name_hmac,
        phone_encrypted: protectedSignup.phone_encrypted,
        phone_hmac: protectedSignup.phone_hmac,
        pii_crypto_version: protectedSignup.pii_crypto_version,
        plan_code: plan,
        billing_period: billing
      };
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent, JSON.stringify(pendingSignupIntent));
      window.location.href = `/billing/subscription?plan=${encodeURIComponent(plan)}&billing=${encodeURIComponent(billing)}&signup_intent=pending_signup`;
    });

  }
</script>
