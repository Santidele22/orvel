---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Continuando alta" showPreloader={false}>
  <main class="flex min-h-screen w-full items-center justify-center bg-bg-primary px-6 text-text-primary">
    <section class="w-full max-w-md rounded-2xl border border-border bg-bg-secondary/80 p-8 text-center shadow-2xl">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Alta simplificada</p>
      <h1 class="mb-4 font-headline text-3xl font-black tracking-tighter">Te llevamos al siguiente paso</h1>
      <p class="text-sm leading-6 text-text-secondary">
        La configuración del negocio se completa dentro del dashboard. Si no avanzás automáticamente, usá el botón.
      </p>
      <a id="continueLink" href="/auth/signup/credentials" class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-primary px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-secondary shadow-lg shadow-primary/20">
        Continuar
      </a>
    </section>
  </main>
</Layout>

<script>
  import { SIGNUP_STORAGE_KEYS } from '../../../lib/browser-storage-keys';

  if (typeof window !== 'undefined') {
    const searchParams = new URLSearchParams(window.location.search);
    const explicitPlan = searchParams.get('plan');
    const normalizeSelectedPlan = (rawPlan: string | null) => {
      const normalized = rawPlan?.trim().toUpperCase();
      return normalized && normalized.length > 0 ? normalized : 'FREE';
    };
    const normalizeBillingPeriod = (rawBilling: string | null) => {
      const normalized = rawBilling?.trim().toLowerCase();
      return normalized === 'quarterly' || normalized === 'annual' ? normalized : 'monthly';
    };
    const plan = normalizeSelectedPlan(explicitPlan || sessionStorage.getItem(SIGNUP_STORAGE_KEYS.plan));
    const isExplicitFreePlan = explicitPlan?.trim().toUpperCase() === 'FREE';
    const billing = normalizeBillingPeriod(isExplicitFreePlan ? searchParams.get('billing') : searchParams.get('billing') || sessionStorage.getItem(SIGNUP_STORAGE_KEYS.billing));
    const isPaidPlan = plan !== 'FREE';
    if (isExplicitFreePlan || plan === 'FREE') {
      sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent);
    }
    const step2Link = document.getElementById('continueLink') as HTMLAnchorElement | null;
    const backBtn = step2Link;
    sessionStorage.setItem(SIGNUP_STORAGE_KEYS.plan, plan);
    sessionStorage.setItem(SIGNUP_STORAGE_KEYS.billing, billing);

    const credentialsUrl = `/auth/signup/credentials?plan=${encodeURIComponent(plan)}&billing=${encodeURIComponent(billing)}`;
    if (step2Link) step2Link.href = credentialsUrl;
    if (backBtn) backBtn.href = credentialsUrl;
    const params = new URLSearchParams();
    params.set('billing', billing);

    const buildDashboardOnboardingUrl = () => {
      const configuredDashboardOrigin = import.meta.env.PUBLIC_DASHBOARD_URL?.trim();
      const dashboardOrigin = configuredDashboardOrigin
        || (window.location.hostname === 'localhost' && window.location.port === '3000'
          ? window.location.origin
          : 'http://localhost:4200');
      const onboardingUrl = new URL('/auth/onboarding', dashboardOrigin);
      onboardingUrl.searchParams.set('onboarding_required', 'true');
      onboardingUrl.searchParams.set('returnTo', '/dashboard/inicio');
      onboardingUrl.searchParams.set('plan', plan);
      onboardingUrl.searchParams.set('billing', billing);
      return onboardingUrl.toString();
    };

    const returnTo = isPaidPlan
      ? `/billing/subscription?plan=${encodeURIComponent(plan)}&billing=${encodeURIComponent(billing)}`
      : buildDashboardOnboardingUrl();

    const readProtectedPendingSignupIntent = () => {
      try {
        const raw = sessionStorage.getItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (typeof parsed?.intent_id === 'string' && parsed.intent_id.trim()) return parsed;
        if (typeof parsed?.email_encrypted === 'string' && typeof parsed?.email_hmac === 'string') return parsed;
      } catch {
        // Ignore invalid resume markers.
      }
      return null;
    };

    const protectedPendingSignupIntent = readProtectedPendingSignupIntent();
    if (isPaidPlan && protectedPendingSignupIntent) {
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent, JSON.stringify({
        ...protectedPendingSignupIntent,
        plan_code: plan,
        billing_period: billing
      }));
      window.location.href = `${returnTo}&signup_intent=pending_signup`;
    } else if (!isPaidPlan) {
      window.location.href = `/auth/signup/credentials?plan=${encodeURIComponent(plan)}&billing=${encodeURIComponent(billing)}&resume=credentials_first`;
    }
  }
</script>
