---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Alta creada" showPreloader={false}>
  <main class="flex min-h-screen w-full items-center justify-center bg-bg-primary px-6 text-text-primary">
    <section class="w-full max-w-2xl rounded-2xl border border-border bg-bg-secondary/80 p-8 shadow-2xl">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Paso 3 de 3</p>
      <h1 class="mb-3 font-headline text-3xl font-black tracking-tighter">Tu Rubro.</h1>
      <p class="text-sm leading-6 text-text-secondary">Seleccioná una categoría de tu negocio.</p>
      <p class="mt-2 text-xs leading-5 text-text-secondary">Elegí la categoría que mejor describe tu salón para adaptar las herramientas. Personalizá tu experiencia.</p>

      <form id="completeForm" data-form-alias="onboardingForm" class="mt-8 space-y-6">
        <fieldset class="grid gap-3 sm:grid-cols-2" aria-describedby="onboardingHelper onboardingError">
          <legend class="sr-only">Categoría del negocio</legend>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="peluqueria" /><span>Peluquería</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="unas" /><span>Uñas</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="barberia" /><span>Barbería</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="spa" /><span>Spa</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="pestanas" /><span>Pestañas</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="cejas" /><span>Cejas</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="masajes" /><span>Masajes</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="otro" /><span>Otro</span></label>
        </fieldset>
        <p id="onboardingHelper" class="text-xs text-text-secondary">Seleccioná una categoría para continuar.</p>
        <p id="onboardingError" class="hidden rounded-lg border border-error/30 bg-error/10 px-4 py-3 text-sm text-error" role="alert"></p>
        <button id="completeOnboardingBtn" type="submit" class="inline-flex w-full items-center justify-center rounded-full bg-primary px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-secondary shadow-lg shadow-primary/20">
          FINALIZAR CONFIGURACIÓN
        </button>
      </form>
    </section>
  </main>

  <div id="accountCreatedModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-hidden bg-black/70 px-6" role="dialog" aria-modal="true" aria-labelledby="accountCreatedTitle" aria-describedby="accountCreatedDescription">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" data-confetti="welcome">
      <span class="confetti-piece left-[12%] bg-primary animation-delay-0"></span>
      <span class="confetti-piece left-[24%] bg-accent animation-delay-150"></span>
      <span class="confetti-piece left-[38%] bg-success animation-delay-300"></span>
      <span class="confetti-piece left-[52%] bg-primary animation-delay-75"></span>
      <span class="confetti-piece left-[66%] bg-accent animation-delay-225"></span>
      <span class="confetti-piece left-[80%] bg-success animation-delay-375"></span>
    </div>
    <section class="relative w-full max-w-sm rounded-2xl border border-border bg-bg-secondary p-6 text-center shadow-2xl">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Cuenta lista</p>
      <h2 id="accountCreatedTitle" tabindex="-1" class="font-headline text-2xl font-black tracking-tighter text-text-primary">¡Bienvenida a Orvel!</h2>
      <p id="accountCreatedDescription" class="mt-3 text-sm leading-6 text-text-secondary">
        Tu cuenta y configuración inicial ya están listas. Iniciá sesión para empezar a organizar tus turnos con Orvel.
      </p>
      <a id="accountCreatedContinue" href="/auth/login" class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-primary px-5 py-3 text-xs font-bold uppercase tracking-widest text-on-secondary">
        Iniciar sesión
      </a>
    </section>
  </div>
</Layout>

<style>
  .confetti-piece {
    position: absolute;
    top: -1rem;
    height: 0.9rem;
    width: 0.45rem;
    border-radius: 999px;
    animation: welcome-confetti 2.8s ease-in-out infinite;
    opacity: 0.9;
  }

  .animation-delay-0 { animation-delay: 0ms; }
  .animation-delay-75 { animation-delay: 75ms; }
  .animation-delay-150 { animation-delay: 150ms; }
  .animation-delay-225 { animation-delay: 225ms; }
  .animation-delay-300 { animation-delay: 300ms; }
  .animation-delay-375 { animation-delay: 375ms; }

  @keyframes welcome-confetti {
    0% { transform: translate3d(0, -10%, 0) rotate(0deg); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: translate3d(1.75rem, 105vh, 0) rotate(540deg); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .confetti-piece {
      animation: none;
      top: 1rem;
      opacity: 0.7;
    }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { SIGNUP_STORAGE_KEYS } from '../../../lib/browser-storage-keys';
  import { markSignupOnboardingCompleted } from '../../../lib/onboarding-signup-state';
  import { createSupabaseBrowserAuthOptions } from '../../../lib/supabase-auth-adapter';

  if (typeof window !== 'undefined') {
    const params = new URLSearchParams(window.location.search);
    const sanitizeLoginUrl = (rawLoginUrl: string | null) => {
      if (!rawLoginUrl) return '/auth/login';
      try {
        const candidate = new URL(rawLoginUrl, window.location.origin);
        return candidate.origin === window.location.origin && candidate.pathname === '/auth/login' ? '/auth/login' : '/auth/login';
      } catch {
        return '/auth/login';
      }
    };
    const resolveDashboardBaseUrl = () => {
      try {
        return new URL(import.meta.env.PUBLIC_DASHBOARD_URL || 'https://dashboard.orvel.pro');
      } catch {
        return new URL('https://dashboard.orvel.pro');
      }
    };
    const sanitizeReturnTo = (rawReturnTo: string | null) => {
      const dashboardBaseUrl = resolveDashboardBaseUrl();
      const fallback = new URL('/dashboard/inicio', dashboardBaseUrl).toString();
      const value = rawReturnTo?.trim();
      if (!value || value.startsWith('//') || /^(?:javascript|data):/i.test(value) || /(access_token|refresh_token|id_token|code)/i.test(value)) {
        return fallback;
      }

      try {
        const candidate = new URL(value, window.location.origin);
        if (candidate.origin === window.location.origin && (candidate.pathname === '/dashboard' || candidate.pathname.startsWith('/dashboard/'))) {
          return new URL(`${candidate.pathname}${candidate.search}${candidate.hash}`, dashboardBaseUrl).toString();
        }
        if (candidate.origin === dashboardBaseUrl.origin && (candidate.pathname === '/dashboard' || candidate.pathname.startsWith('/dashboard/'))) {
          return candidate.toString();
        }
      } catch {
        return fallback;
      }

      return fallback;
    };
    const safeReturnTo = sanitizeReturnTo(params.get('returnTo'));
    const safeLoginUrl = sanitizeLoginUrl(params.get('loginUrl'));
    const onboardingSource = params.get('source');
    const normalizedOnboardingSource = onboardingSource === 'subscription' ? 'subscription' : 'signup';
    const backendConfirmationFailureMessage = 'Guardamos tu selección en este navegador, pero no pudimos confirmar la configuración. Iniciá sesión para continuar y retomar la configuración.';
    const buildOnboardingResumeLoginUrl = () => {
      const loginUrl = new URL('/auth/login', window.location.origin);
      const resumeUrl = new URL(window.location.pathname, window.location.origin);
      const resumeParams = new URLSearchParams(window.location.search);
      resumeParams.set('resume', 'onboarding');
      resumeParams.set('source', normalizedOnboardingSource);
      resumeUrl.search = resumeParams.toString();
      loginUrl.searchParams.set('returnTo', `${resumeUrl.pathname}${resumeUrl.search}`);
      loginUrl.searchParams.set('resume', 'onboarding');
      loginUrl.searchParams.set('source', normalizedOnboardingSource);
      return `${loginUrl.pathname}${loginUrl.search}`;
    };
    const loginLink = null as HTMLAnchorElement | null;
    const continueLink = document.getElementById('accountCreatedContinue') as HTMLAnchorElement | null;
    if (continueLink) continueLink.href = safeLoginUrl;

    const showAccountCreatedModal = () => {
      const modal = document.getElementById('accountCreatedModal');
      modal?.setAttribute('data-onboarding-source', normalizedOnboardingSource);
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.getElementById('accountCreatedTitle')?.focus();
    };

    const normalizeBusinessType = (value: string) => value === 'unas' ? 'uñas' : value === 'pestanas' ? 'pestañas' : value;
    const normalizePlanCode = (value: string | null) => {
      const normalized = value?.trim().toUpperCase();
      if (normalized === 'BASIC' || normalized === 'STARTER') return 'STARTED';
      if (normalized === 'MEDIUM') return 'GROWTH';
      return ['FREE', 'STARTED', 'GROWTH', 'PRO'].includes(normalized ?? '') ? normalized : 'FREE';
    };
    const currentPlan = normalizePlanCode(params.get('plan'));
    const isFreeSignupOnboarding = normalizedOnboardingSource === 'signup' && currentPlan === 'FREE';
    const FREE_SIGNUP_HANDOFF_STORAGE_KEYS = [
      SIGNUP_STORAGE_KEYS.plan,
      SIGNUP_STORAGE_KEYS.billing,
      SIGNUP_STORAGE_KEYS.pendingSignupIntent,
      SIGNUP_STORAGE_KEYS.tipoNegocio,
      'orvel.signup.selectedRubros'
    ] as const;
    const clearFreeSignupHandoffStorage = () => {
      for (const key of FREE_SIGNUP_HANDOFF_STORAGE_KEYS) {
        sessionStorage.removeItem(key);
      }
    };
    if (continueLink && isFreeSignupOnboarding) {
      continueLink.addEventListener('click', clearFreeSignupHandoffStorage);
    }
    const readStringField = (value: unknown, key: string) => {
      if (!value || typeof value !== 'object') return '';
      const field = (value as Record<string, unknown>)[key];
      return typeof field === 'string' ? field.trim() : '';
    };
    const readProtectedPendingSignupIntent = () => {
      try {
        const raw = sessionStorage.getItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (typeof parsed?.email_encrypted === 'string' && typeof parsed?.email_hmac === 'string') return parsed;
      } catch {
        // Invalid or tampered handoff; finalization will ask the user to restart.
      }
      return null;
    };
    const syncOnboardingMetadata = async (selectedRubros: string[]) => {
      if (!import.meta.env.PUBLIC_SUPABASE_URL || !import.meta.env.PUBLIC_SUPABASE_ANON_KEY) return { synced: false, reason: 'missing_config' };
      const client = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
        createSupabaseBrowserAuthOptions(localStorage)
      );
      const { data } = await client.auth.getSession();
      const email = data.session?.user?.email;
      if (!data.session?.access_token || !email) return { synced: false, reason: 'missing_session', loginUrl: buildOnboardingResumeLoginUrl() };
      const primaryType = normalizeBusinessType(selectedRubros[0] ?? 'otro');
      const businessName = typeof data.session.user.user_metadata?.negocioNombre === 'string'
        ? data.session.user.user_metadata.negocioNombre
        : 'Mi Negocio';
      const { data: onboardingResult, error } = await client.rpc('complete_signup_onboarding', {
        p_business_name: businessName,
        p_business_type: primaryType,
        p_plan_code: normalizePlanCode(params.get('plan'))
      });
      if (error) return { synced: false, reason: 'update_failed' };
      const bookingSlug = onboardingResult?.booking_slug || readStringField(onboardingResult, 'slug');
      const businessId = readStringField(onboardingResult, 'business_id');
      const persistedBusinessName = readStringField(onboardingResult, 'business_name') || businessName;
      if (!bookingSlug || !businessId) return { synced: false, reason: 'missing_backend_identity' };
      sessionStorage.setItem('orvel.signup.business_identity', JSON.stringify({
        business_id: businessId,
        business_name: persistedBusinessName,
        booking_slug: bookingSlug,
        business_type: readStringField(onboardingResult, 'business_type') || primaryType,
        plan: readStringField(onboardingResult, 'plan') || normalizePlanCode(params.get('plan')),
        dashboard_ready: true
      }));
      markSignupOnboardingCompleted({ email, selectedRubros });
      return { synced: true };
    };
    const completeFreeSignupFromOnboarding = async (_selectedRubros: string[]) => {
      return { ok: true, redirectTo: safeReturnTo };
    };

    const form = document.getElementById('completeForm') as HTMLFormElement | null;
    const errorEl = document.getElementById('onboardingError');
    const button = document.getElementById('completeOnboardingBtn') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const selectedRubros = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="rubro"]:checked')).map((input) => input.value).slice(0, 1);
      if (selectedRubros.length === 0) {
        if (errorEl) {
          errorEl.textContent = 'Seleccioná una categoría para continuar.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      if (button) {
        button.disabled = true;
        button.textContent = 'Guardando configuración...';
      }
      if (errorEl) errorEl.classList.add('hidden');
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.tipoNegocio, normalizeBusinessType(selectedRubros[0] ?? 'otro'));
      // syncOnboardingMetadata(selectedRubros) remains the session-backed path below.
      sessionStorage.setItem('orvel.signup.selectedRubros', JSON.stringify(selectedRubros));

      if (isFreeSignupOnboarding) {
        const signupResult = await completeFreeSignupFromOnboarding(selectedRubros).catch(() => ({ ok: false, error: 'No pudimos crear tu cuenta. Reintentá en unos segundos.' }));
        if (signupResult.ok) {
          window.location.assign(signupResult.redirectTo || safeReturnTo);
          return;
        }
        if (errorEl) {
          errorEl.textContent = signupResult.error || 'No pudimos crear tu cuenta. Reintentá en unos segundos.';
          errorEl.classList.remove('hidden');
        }
        if (button) {
          button.disabled = false;
          button.textContent = 'FINALIZAR CONFIGURACIÓN';
        }
        return;
      }

      const result = await syncOnboardingMetadata(selectedRubros).catch(() => ({ synced: false, reason: 'update_failed' }));
      if (result.synced) {
        showAccountCreatedModal();
        return;
      }

      if (result.reason === 'missing_session' && errorEl) {
        const loginUrl = 'loginUrl' in result && typeof result.loginUrl === 'string' ? result.loginUrl : buildOnboardingResumeLoginUrl();
        if (loginLink) loginLink.href = loginUrl;
        errorEl.textContent = 'Guardamos tu categoría en este navegador. Para confirmarla, iniciá sesión y vas a volver a esta pantalla para retomar el onboarding.';
        errorEl.classList.remove('hidden');
        if (button) {
          button.disabled = false;
          button.textContent = 'FINALIZAR CONFIGURACIÓN';
        }
        return;
      }

      if (!result.synced && errorEl) {
        errorEl.textContent = backendConfirmationFailureMessage;
        errorEl.classList.remove('hidden');
      }
      if (button) {
        button.disabled = false;
        button.textContent = 'FINALIZAR CONFIGURACIÓN';
      }
    });
  }
</script>
