---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Alta creada" showPreloader={false}>
  <main class="flex min-h-screen w-full items-center justify-center bg-bg-primary px-6 text-text-primary">
    <section class="w-full max-w-2xl rounded-2xl border border-border bg-bg-secondary/80 p-8 shadow-2xl">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Paso 3 de 3</p>
      <h1 class="mb-3 font-headline text-3xl font-black tracking-tighter">Tu Rubro.</h1>
      <p class="text-sm leading-6 text-text-secondary">Seleccioná una categoría de tu negocio.</p>
      <p class="mt-2 text-xs leading-5 text-text-secondary">Elegí la categoría que mejor describe tu salón para adaptar las herramientas. Personalizá tu experiencia.</p>

      <form id="completeForm" data-form-alias="onboardingForm" class="mt-8 space-y-6">
        <fieldset class="grid gap-3 sm:grid-cols-2" aria-describedby="onboardingHelper onboardingError">
          <legend class="sr-only">Categoría del negocio</legend>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="peluqueria" /><span>Peluquería</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="unas" /><span>Uñas</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="barberia" /><span>Barbería</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="spa" /><span>Spa</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="pestanas" /><span>Pestañas</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="cejas" /><span>Cejas</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="masajes" /><span>Masajes</span></label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg-primary/60 p-4 text-sm font-semibold transition hover:border-primary/60"><input class="h-4 w-4 accent-primary" type="radio" name="rubro" value="otro" /><span>Otro</span></label>
        </fieldset>
        <p id="onboardingHelper" class="text-xs text-text-secondary">Seleccioná una categoría para continuar.</p>
        <p id="onboardingError" class="hidden rounded-lg border border-error/30 bg-error/10 px-4 py-3 text-sm text-error" role="alert"></p>
        <button id="completeOnboardingBtn" type="submit" class="inline-flex w-full items-center justify-center rounded-full bg-primary px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-secondary shadow-lg shadow-primary/20">
          FINALIZAR CONFIGURACIÓN
        </button>
      </form>

      <a id="loginLink" href="/auth/login" class="mt-4 inline-flex w-full items-center justify-center rounded-full border border-primary/40 px-6 py-3 text-xs font-bold uppercase tracking-widest text-primary">
        Ir al login
      </a>
    </section>
  </main>

  <div id="accountCreatedModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 px-6" role="dialog" aria-modal="true" aria-labelledby="accountCreatedTitle" aria-describedby="accountCreatedDescription">
    <section class="w-full max-w-sm rounded-2xl border border-border bg-bg-secondary p-6 text-center shadow-2xl">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Cuenta creada</p>
      <h2 id="accountCreatedTitle" tabindex="-1" class="font-headline text-2xl font-black tracking-tighter text-text-primary">Ya podés iniciar sesión</h2>
      <p id="accountCreatedDescription" class="mt-3 text-sm leading-6 text-text-secondary">
        Creamos tu cuenta. Por seguridad, iniciá sesión para continuar con Orvel.
      </p>
      <button id="accountCreatedContinue" type="button" class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-primary px-5 py-3 text-xs font-bold uppercase tracking-widest text-on-secondary">
        Continuar al login
      </button>
    </section>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { SIGNUP_STORAGE_KEYS } from '../../../lib/browser-storage-keys';
  import { markSignupOnboardingCompleted } from '../../../lib/onboarding-signup-state';
  import { createSupabaseBrowserAuthOptions } from '../../../lib/supabase-auth-adapter';

  if (typeof window !== 'undefined') {
    const params = new URLSearchParams(window.location.search);
    const sanitizeLoginUrl = (rawLoginUrl: string | null) => {
      if (!rawLoginUrl) return '/auth/login';
      try {
        const candidate = new URL(rawLoginUrl, window.location.origin);
        return candidate.origin === window.location.origin && candidate.pathname === '/auth/login' ? '/auth/login' : '/auth/login';
      } catch {
        return '/auth/login';
      }
    };
    const resolveDashboardBaseUrl = () => {
      try {
        return new URL(import.meta.env.PUBLIC_DASHBOARD_URL || 'https://dashboard.orvel.pro');
      } catch {
        return new URL('https://dashboard.orvel.pro');
      }
    };
    const sanitizeReturnTo = (rawReturnTo: string | null) => {
      const dashboardBaseUrl = resolveDashboardBaseUrl();
      const fallback = new URL('/dashboard/inicio', dashboardBaseUrl).toString();
      const value = rawReturnTo?.trim();
      if (!value || value.startsWith('//') || /^(?:javascript|data):/i.test(value) || /(access_token|refresh_token|id_token|code)/i.test(value)) {
        return fallback;
      }

      try {
        const candidate = new URL(value, window.location.origin);
        if (candidate.origin === window.location.origin && (candidate.pathname === '/dashboard' || candidate.pathname.startsWith('/dashboard/'))) {
          return new URL(`${candidate.pathname}${candidate.search}${candidate.hash}`, dashboardBaseUrl).toString();
        }
        if (candidate.origin === dashboardBaseUrl.origin && (candidate.pathname === '/dashboard' || candidate.pathname.startsWith('/dashboard/'))) {
          return candidate.toString();
        }
      } catch {
        return fallback;
      }

      return fallback;
    };
    const safeReturnTo = sanitizeReturnTo(params.get('returnTo'));
    const safeLoginUrl = sanitizeLoginUrl(params.get('loginUrl'));
    const loginLink = document.getElementById('loginLink') as HTMLAnchorElement | null;
    if (loginLink) loginLink.href = safeLoginUrl;

    const redirectToLogin = () => {
      window.location.href = safeLoginUrl;
    };

    const showAccountCreatedModal = () => {
      const modal = document.getElementById('accountCreatedModal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.getElementById('accountCreatedTitle')?.focus();
      document.getElementById('accountCreatedContinue')?.addEventListener('click', redirectToLogin);
      window.setTimeout(redirectToLogin, 3500);
    };

    const normalizeBusinessType = (value: string) => value === 'unas' ? 'uñas' : value === 'pestanas' ? 'pestañas' : value;
    const syncOnboardingMetadata = async (selectedRubros: string[]) => {
      if (!import.meta.env.PUBLIC_SUPABASE_URL || !import.meta.env.PUBLIC_SUPABASE_ANON_KEY) return { synced: false, reason: 'missing_config' };
      const client = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
        createSupabaseBrowserAuthOptions(localStorage)
      );
      const { data } = await client.auth.getSession();
      const email = data.session?.user?.email;
      if (!data.session?.access_token || !email) return { synced: false, reason: 'missing_session' };
      const primaryType = normalizeBusinessType(selectedRubros[0] ?? 'otro');
      const { error } = await client.auth.updateUser({
        data: {
          tipoNegocio: primaryType,
          selectedRubros,
          selectedBusinessTypes: selectedRubros.map(normalizeBusinessType),
          onboardingCompleted: true,
          onboarding_completed: true
        }
      });
      if (error) return { synced: false, reason: 'update_failed' };
      markSignupOnboardingCompleted({ email, selectedRubros });
      return { synced: true };
    };

    const form = document.getElementById('completeForm') as HTMLFormElement | null;
    const errorEl = document.getElementById('onboardingError');
    const button = document.getElementById('completeOnboardingBtn') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const selectedRubros = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="rubro"]:checked')).map((input) => input.value).slice(0, 1);
      if (selectedRubros.length === 0) {
        if (errorEl) {
          errorEl.textContent = 'Seleccioná una categoría para continuar.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      if (button) {
        button.disabled = true;
        button.textContent = 'Guardando configuración...';
      }
      if (errorEl) errorEl.classList.add('hidden');
      sessionStorage.setItem(SIGNUP_STORAGE_KEYS.tipoNegocio, normalizeBusinessType(selectedRubros[0] ?? 'otro'));
      sessionStorage.setItem('orvel.signup.selectedRubros', JSON.stringify(selectedRubros));

      const result = await syncOnboardingMetadata(selectedRubros).catch(() => ({ synced: false, reason: 'update_failed' }));
      if (result.synced) {
        window.location.href = safeReturnTo;
        return;
      }

      if (!result.synced && errorEl) {
        errorEl.textContent = 'Guardamos tu selección en este navegador, pero no pudimos confirmarla con backend. Iniciá sesión para continuar y retomar la configuración.';
        errorEl.classList.remove('hidden');
      }
      if (button) {
        button.disabled = false;
        button.textContent = 'FINALIZAR CONFIGURACIÓN';
      }
    });
  }
</script>
