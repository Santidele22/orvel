---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Conectando Google">
  <main class="flex min-h-screen w-full items-center justify-center bg-[#0e0e0e] px-8">
    <section class="max-w-md rounded-2xl border border-[#dcc1b4]/20 bg-[#1c1b1b] p-8 text-center shadow-2xl shadow-black/30">
      <p class="mb-4 text-[10px] uppercase tracking-[0.2em] text-[#dcc1b4]">Google OAuth</p>
      <h1 class="mb-3 font-headline text-3xl font-bold tracking-tighter text-text-primary">Preparando tu atelier</h1>
      <p id="oauthCallbackStatus" class="text-sm font-light text-text-primary">Validando tu cuenta y recuperando el plan seleccionado…</p>
    </section>
  </main>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    createSupabaseBrowserAuthOptions,
    getOAuthExchangeDiagnostics
  } from '../../../lib/supabase-auth-adapter';
  import {
    createBrowserOAuthSignupIntentStore,
    handleOAuthOnboardingCallback,
    OAuthOnboardingError
  } from '../../../lib/oauth-signup-onboarding-flow';

  if (typeof window !== 'undefined') {
    const status = document.getElementById('oauthCallbackStatus');
    const cookiePlan = document.cookie
      .split('; ')
      .find((entry) => entry.startsWith('orvel.oauth.signup.plan='))
      ?.split('=')[1];
    const fallbackPlan =
      new URLSearchParams(window.location.search).get('plan') ||
      sessionStorage.getItem('orvel.signup.plan') ||
      (cookiePlan ? decodeURIComponent(cookiePlan) : '');

    const fail = (error: unknown) => {
      const code =
        error instanceof OAuthOnboardingError
          ? error.code
          : error instanceof Error && /provider code/i.test(error.message)
            ? 'missing_provider_code'
            : 'oauth_exchange_failed';
      const message = 'No pudimos completar Google OAuth. Volvé a intentar desde credenciales.';
      if (status) status.textContent = message;
      const params = new URLSearchParams(window.location.search);
      const target = new URL('/auth/signup/credentials', window.location.origin);
      if (fallbackPlan) target.searchParams.set('plan', fallbackPlan);
      target.searchParams.set('oauth_error_code', code);
      console.warn('[orvel-oauth-signup] onboarding callback could not recover', {
        reason: code,
        hasCode: params.has('code'),
        hasHash: window.location.hash.length > 0,
        hasSignupIntent: params.has('signup_intent'),
        hasPlan: Boolean(fallbackPlan),
        exchangeError: getOAuthExchangeDiagnostics(error)
      });
      window.setTimeout(() => {
        window.location.href = `${target.pathname}${target.search}`;
      }, 1200);
    };

    try {
      const client = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
        createSupabaseBrowserAuthOptions(localStorage)
      );
      const intentStore = createBrowserOAuthSignupIntentStore(sessionStorage);

      const result = await handleOAuthOnboardingCallback({
        url: window.location.href,
        intentStore,
        fallbackPlan,
        exchangeCodeForSession: async (code) => {
          const { data, error } = await client.auth.exchangeCodeForSession(code);
          if (error) throw error;
          if (!data.user) throw new Error('Google no devolvió una sesión válida.');
          return { user: data.user };
        },
        getCurrentSessionUser: async () => {
          const { data, error } = await client.auth.getUser();
          if (error) throw error;
          return { user: data.user ?? null };
        }
      });

      sessionStorage.setItem('orvel.signup.plan', result.plan);
      const secureCookie = window.location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `orvel.oauth.signup.plan=${encodeURIComponent(result.plan)}; Max-Age=0; Path=/; SameSite=Lax${secureCookie}`;
      window.location.href = result.redirectTo;
    } catch (error) {
      fail(error);
    }
  }
</script>
