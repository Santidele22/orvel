---
import Layout from '../layouts/Layout.astro';
import { getActivePlans, calculateBillingPrices } from '../lib/plans';
import { EARLY_BIRD_OCCUPIED, getCurrentFranja } from '../lib/waitlist';
import { fetchWaitlistOccupied } from '../lib/waitlist-sheet';

import PrelaunchHeader from '../components/organisms/prelaunch/PrelaunchHeader.astro';
import PrelaunchHero from '../components/organisms/prelaunch/PrelaunchHero.astro';
import PrelaunchRubros from '../components/organisms/prelaunch/PrelaunchRubros.astro';
import EarlyBird from '../components/organisms/prelaunch/EarlyBird.astro';
import PrelaunchHowItWorks from '../components/organisms/prelaunch/PrelaunchHowItWorks.astro';
import PrelaunchPublicTurnero from '../components/organisms/prelaunch/PrelaunchPublicTurnero.astro';
import PrelaunchProductShowcase from '../components/organisms/prelaunch/PrelaunchProductShowcase.astro';
import PrelaunchPricing from '../components/organisms/prelaunch/PrelaunchPricing.astro';
import PrelaunchFaq from '../components/organisms/prelaunch/PrelaunchFaq.astro';
import PrelaunchCta from '../components/organisms/prelaunch/PrelaunchCta.astro';
import Footer from '../components/organisms/Footer.astro';

const occupied =
  (await fetchWaitlistOccupied({
    webhookUrl: process.env.WAITLIST_SHEETS_WEBHOOK_URL || import.meta.env.WAITLIST_SHEETS_WEBHOOK_URL,
    secret: process.env.WAITLIST_SHEETS_SECRET || import.meta.env.WAITLIST_SHEETS_SECRET
  })) ?? EARLY_BIRD_OCCUPIED;
const franja = getCurrentFranja(occupied);
const plans = await getActivePlans();
const plansWithBilling = plans.map((plan) => calculateBillingPrices(plan));
const premium = plansWithBilling.find((plan) => plan.code === 'PREMIUM');
const premiumPriceLabel = premium ? `$${premium.price.toLocaleString('es-AR')}` : '$25.000';
---

<Layout
  title="Orvel — Menos ida y vuelta. Más salón."
  description="Tu cliente reserva. Vos atendés. Creá tu cuenta. Primeros 50 con descuento en el primer mes de Premium."
>
  <PrelaunchHeader />
  <PrelaunchHero />
  <PrelaunchRubros />
  <EarlyBird occupied={occupied} franja={franja} />
  <PrelaunchHowItWorks />
  <PrelaunchPublicTurnero />
  <PrelaunchProductShowcase />
  <PrelaunchPricing plansWithBilling={plansWithBilling} />
  <PrelaunchFaq premiumPriceLabel={premiumPriceLabel} />
  <PrelaunchCta />
  <Footer />
</Layout>
