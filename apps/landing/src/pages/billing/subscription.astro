---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Orvel - Confirmá tu suscripción">
  <main class="min-h-screen bg-bg-primary text-text-primary font-body">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-12 lg:grid-cols-2 lg:gap-12 lg:px-10 lg:py-16">
      
      <!-- LEFT COLUMN: Plan Summary -->
      <section class="relative overflow-hidden rounded-2xl border border-border bg-bg-secondary/70 p-8 shadow-2xl">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/30 via-bg-primary/70 to-bg-primary"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(167,139,250,0.25),transparent_42%)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_75%,rgba(124,58,237,0.2),transparent_38%)]"></div>

        <div class="relative z-10 space-y-8">
          <!-- Badge -->
          <div class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
            Paso final
          </div>

          <!-- Header -->
          <header class="space-y-3">
            <h1 class="font-headline text-3xl md:text-4xl font-black tracking-tighter leading-[1.1]">
              Confirmá tu plan y activá tu suscripción.
            </h1>
            <p class="max-w-md text-sm text-text-secondary leading-relaxed">
              Vas a ser redirigir a Mercado Pago para completar el pago seguro. Podés pagar con tarjetas, medios de pago locales y métodos de Mercado Pago.
            </p>
          </header>

          <!-- Plan Card -->
          <article id="planSummary" class="rounded-xl border border-primary/40 bg-bg-primary/60 p-6 backdrop-blur-sm shadow-lg shadow-primary/5">
            <div class="flex items-center justify-between mb-4">
              <p class="text-[10px] uppercase tracking-[0.2em] text-text-secondary">Plan seleccionado</p>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-primary shadow-[0_0_8px_rgba(124,58,237,0.6)]"></div>
                <span id="planStateBadge" class="text-[10px] font-medium text-primary">Pago pendiente</span>
              </div>
            </div>
            <div class="mt-2 mb-3">
              <h2 id="planSummaryName" class="font-headline text-3xl font-black tracking-tight text-white">FREE</h2>
              <p id="planSummaryPrice" class="text-lg font-semibold text-primary-light mt-1">$0 / mes</p>
            </div>
            <p id="planSummaryDetail" class="text-sm text-text-secondary leading-relaxed border-t border-border/50 pt-3 mt-3">Hasta 15 turnos por mes para empezar.</p>
          </article>

          <!-- Trust Items -->
          <div class="space-y-3">
            <p class="text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2">Incluye</p>
            <div class="flex items-center gap-3 text-sm text-text-primary">
              <svg class="w-4 h-4 text-success shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Renovación automática</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-text-primary">
              <svg class="w-4 h-4 text-success shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Cancelación en cualquier momento</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-text-primary">
              <svg class="w-4 h-4 text-success shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Facturación segura y protegida</span>
            </div>
          </div>
        </div>
      </section>

      <!-- RIGHT COLUMN: Trust/Confirmation -->
      <section class="relative overflow-hidden rounded-2xl border border-border bg-bg-secondary/60 p-6 shadow-xl sm:p-8">
        <div class="relative z-10 space-y-8">
          <!-- Header -->
          <header class="space-y-3">
            <h2 class="font-headline text-2xl font-bold tracking-tight text-white">
              Finalizá tu suscripción
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Mercado Pago procesará tu pago. Activamos el acceso solo cuando Orvel confirma el estado final.
            </p>
          </header>

          <!-- Trust List -->
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-success/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm text-text-primary">Pago seguro con Mercado Pago</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-success/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm text-text-primary">Cobros recurrentes automáticos</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-success/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm text-text-primary">Tarjetas y medios de pago locales</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-success/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm text-text-primary">Facturación protegida</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-success/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm text-text-primary">Activación automática del plan</span>
            </li>
          </ul>

          <!-- What Happens Next -->
          <div class="rounded-xl bg-bg-primary/40 border border-border p-5">
            <h3 class="text-xs font-bold uppercase tracking-widest text-primary mb-4">¿Qué pasa después?</h3>
            <ol class="space-y-3">
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary/20 text-[10px] font-bold text-primary">1</span>
                <span class="text-sm text-text-secondary">Continuás a Mercado Pago</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary/20 text-[10px] font-bold text-primary">2</span>
                <span class="text-sm text-text-secondary">Completás el pago</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary/20 text-[10px] font-bold text-primary">3</span>
               <span class="text-sm text-text-secondary">Orvel valida el estado de pago</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary/20 text-[10px] font-bold text-primary">4</span>
               <span class="text-sm text-text-secondary">Te habilitamos acceso cuando el estado esté aprobado</span>
              </li>
            </ol>
          </div>

          <!-- Security Badge -->
          <div class="flex items-center justify-center gap-2 text-[10px] text-text-secondary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Orvel no almacena datos de tu tarjeta</span>
          </div>

          <div class="mt-8"></div>

          <!-- Primary CTA Button -->
          <div id="subscriptionStatus" class="rounded-lg bg-primary/10 border border-primary/30 px-4 py-3 text-sm text-text-primary text-center hidden">Estado: pendiente de pago.</div>
          <div id="subscriptionError" class="hidden rounded-lg bg-error/10 border border-error/30 px-4 py-3 text-sm text-error text-center mb-4" role="alert" aria-live="polite"></div>
          
          <button 
            id="subscriptionContinueBtn" 
            type="button"
            class="group relative w-full rounded-full bg-gradient-to-r from-primary to-primary-light py-4 px-6 text-sm font-bold uppercase tracking-widest text-white shadow-lg shadow-primary/30 transition-all duration-300 hover:shadow-xl hover:shadow-primary/50 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary"
          >
            <span class="relative z-10 flex items-center justify-center gap-3">
              Continuar con Mercado Pago
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
            <div class="absolute inset-0 rounded-full bg-white/0 transition-all duration-300 group-hover:bg-white/10"></div>
          </button>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    createSupabaseBrowserAuthOptions,
    ORVEL_SUPABASE_AUTH_STORAGE_KEY
  } from '../../lib/supabase-auth-adapter';
  import { SIGNUP_STORAGE_KEYS, subscriptionAttemptStorageKey } from '../../lib/browser-storage-keys';
  import {
    buildPendingSignupIntentPayload,
    getSubscriptionStartReadiness,
    SUBSCRIPTION_RECOVERY_ERRORS
  } from '../../lib/subscription-page-controller';

  if (typeof window !== 'undefined') {
    const plans = {
      FREE: {
        name: 'FREE',
        price: '$0 / mes',
        detail: 'Hasta 15 turnos por mes para empezar.'
      },
      STARTER: {
        name: 'Starter',
        price: '$12 / mes',
        detail: 'Turnos ilimitados para un local. Sin branding Orvel.'
      },
      GROWTH: {
        name: 'Growth',
        price: '$22 / mes',
        detail: 'Incluye 1 local con métricas, recordatorios y gestión de personal.'
      },
      PRO: {
        name: 'Pro',
        price: '$39 / mes',
        detail: 'Incluye 1 local con soporte prioritario, reportes avanzados y API opcional.'
      }
    } as const;

    // Read plan and error from URL
    const params = new URLSearchParams(window.location.search);
    const rawPlan = (params.get('plan') || '').trim().toUpperCase();
    const normalizedPlan = (rawPlan === 'STARTED' || rawPlan === 'BASIC')
      ? 'STARTER'
      : rawPlan === 'MEDIUM'
        ? 'GROWTH'
        : rawPlan;
    const candidatePlan = normalizedPlan as keyof typeof plans;
    const plan = plans[candidatePlan] ? candidatePlan : 'FREE';
    const normalizeBillingPeriod = (raw: string | null) => {
      const normalized = raw?.trim().toLowerCase();
      return normalized === 'quarterly' || normalized === 'annual' ? normalized : 'monthly';
    };
    const billing = normalizeBillingPeriod(params.get('billing') || sessionStorage.getItem(SIGNUP_STORAGE_KEYS.billing));
    sessionStorage.setItem(SIGNUP_STORAGE_KEYS.billing, billing);

    // Update plan details in UI
    const planName = document.getElementById('planSummaryName');
    const planPrice = document.getElementById('planSummaryPrice');
    const planDetail = document.getElementById('planSummaryDetail');

    if (planName) planName.textContent = plans[plan].name;
    if (planPrice) planPrice.textContent = plans[plan].price;
    if (planDetail) planDetail.textContent = plans[plan].detail;

    // Handle subscription errors from URL
    const subscriptionError = params.get('subscription_error');
    const errorContainer = document.getElementById('subscriptionError');
    const continueBtn = document.getElementById('subscriptionContinueBtn') as HTMLButtonElement | null;
    const originalButtonHtml = continueBtn?.innerHTML || '';

    const errorMessages: Record<string, string> = {
      business_required: 'Primero necesitás terminar la configuración inicial de Orvel antes de activar la suscripción.',
      BUSINESS_REQUIRED: 'Primero necesitás terminar la configuración inicial de Orvel antes de activar la suscripción.',
      pending_signup_intent_business_required: 'No pudimos preparar tu alta paga. Volvé al formulario para revisar los datos antes de pagar.',
      pending_signup_missing: SUBSCRIPTION_RECOVERY_ERRORS.pending_signup_missing,
      PENDING_SIGNUP_EMAIL_REQUIRED: 'Necesitamos proteger tu email antes de iniciar el pago. Volvé al formulario y reintentá.',
      pending_signup_email_required: 'Necesitamos proteger tu email antes de iniciar el pago. Volvé al formulario y reintentá.',
      PENDING_SIGNUP_PII_INVALID: 'No pudimos validar tus datos protegidos. Volvé al formulario y reintentá.',
      pending_signup_pii_invalid: 'No pudimos validar tus datos protegidos. Volvé al formulario y reintentá.',
      PENDING_SIGNUP_ALREADY_EXISTS: 'Ya hay un alta paga pendiente para este email. Volvé al formulario si necesitás regenerar el intento.',
      pending_signup_already_exists: 'Ya hay un alta paga pendiente para este email. Volvé al formulario si necesitás regenerar el intento.',
      EMAIL_ALREADY_REGISTERED: 'Este email ya tiene una cuenta en Orvel. Iniciá sesión para continuar.',
      email_already_registered: 'Este email ya tiene una cuenta en Orvel. Iniciá sesión para continuar.',
      email_required: 'Completá tus datos de contacto para continuar.',
      EMAIL_REQUIRED: 'Completá tus datos de contacto para continuar.',
      UNAUTHORIZED_INVALID_JWT_FORMAT: 'No pudimos iniciar la suscripción. Reintentá en unos segundos.',
      unauthorized_invalid_jwt_format: 'No pudimos iniciar la suscripción. Reintentá en unos segundos.',
      subscription_failed: 'No pudimos iniciar el pago. Reintentá en unos segundos.',
      subscription_error: 'Ocurrió un error al procesar tu solicitud.',
      subscription_retry: 'Reintentá en unos segundos.',
      subscription_config_error: 'La suscripción no está configurada para este entorno.',
      invalid_plan: 'El plan seleccionado no está disponible.',
       PLAN_MAPPING_REQUIRED: 'Falta la configuración del plan. Reintentá en unos minutos.',
       PLAN_MAPPING_INVALID: 'El plan está mal configurado. Contactá soporte.',
      PLAN_IDENTIFIER_INVALID: 'El plan enviado no cumple el contrato de suscripción.',
       plan_mapping_required: 'Falta la configuración del plan. Reintentá en unos minutos.',
       plan_mapping_invalid: 'El plan está mal configurado. Contactá soporte.',
      plan_identifier_invalid: 'El plan enviado no cumple el contrato de suscripción.',
      subscription_cancelled: 'Cancelaste el pago. Podés reintentar cuando quieras.'
    };

    const normalizeSubscriptionErrorCode = (value: unknown) => {
      if (typeof value !== 'string') return '';
      const trimmed = value.trim();
      if (!trimmed) return '';
      if (errorMessages[trimmed]) return trimmed;

      const upper = trimmed.toUpperCase();
      if (errorMessages[upper]) return upper;

      const lower = trimmed.toLowerCase();
      if (errorMessages[lower]) return lower;

      return trimmed;
    };

    const statusContainer = document.getElementById('subscriptionStatus');
    const stateBadge = document.getElementById('planStateBadge');
    let currentUiState: 'pending' | 'failed' | 'cancelled' | 'retry' = 'pending';
    let pollingIntervalId: number | null = null;
    let pollingAttempts = 0;
    const MAX_POLLING_ATTEMPTS = 15;
    const TERMINAL_NON_SUCCESS_STATES = new Set(['failed', 'cancelled']);
    const setUiState = (state: 'pending' | 'failed' | 'cancelled' | 'retry') => {
      if (!statusContainer || !stateBadge) return;
      if (TERMINAL_NON_SUCCESS_STATES.has(currentUiState) && state === 'pending') return;
      currentUiState = state;
      statusContainer.classList.remove('hidden');
      if (state === 'pending') {
        stateBadge.textContent = 'Pago pendiente';
        statusContainer.textContent = 'Estado: estamos esperando confirmación del pago desde backend.';
        return;
      }
      if (state === 'failed') {
        stateBadge.textContent = 'Pago fallido';
        statusContainer.textContent = 'Estado: el pago no pudo procesarse. Revisá tus medios de pago y reintentá.';
        return;
      }
      if (state === 'cancelled') {
        stateBadge.textContent = 'Pago cancelado';
        statusContainer.textContent = 'Estado: cancelaste el flujo de pago. Podés retomarlo desde este paso.';
        return;
      }
      stateBadge.textContent = 'Reintento disponible';
      statusContainer.textContent = 'Estado: hubo un problema temporal. Reintentá iniciar la suscripción.';
    };

    const showSubscriptionError = (codeOrMessage: string) => {
      if (!errorContainer) return;
      const normalizedCode = normalizeSubscriptionErrorCode(codeOrMessage);
       errorContainer.textContent = errorMessages[normalizedCode] || 'No pudimos iniciar la suscripción. Reintentá en unos segundos.';
      errorContainer.classList.remove('hidden');
    };

    const setSubscriptionButtonDisabled = (disabled: boolean) => {
      if (!continueBtn) return;
      continueBtn.disabled = disabled;
      continueBtn.classList.toggle('opacity-50', disabled);
      continueBtn.classList.toggle('cursor-not-allowed', disabled);
    };

    const stopSubscriptionPolling = () => {
      if (pollingIntervalId !== null) {
        window.clearInterval(pollingIntervalId);
        pollingIntervalId = null;
      }
    };

    const parseStoredAccessToken = (storageKey: string, tokenField = 'access_token') => {
      try {
        const rawValue = localStorage.getItem(storageKey);
        if (!rawValue) return null;
        const parsed = JSON.parse(rawValue);
        const token = parsed?.[tokenField] || parsed?.session?.[tokenField];
        return typeof token === 'string' && token ? token : null;
      } catch {
        return null;
      }
    };

    const getSubscriptionAccessToken = async () => {
      try {
        const client = createClient(
          import.meta.env.PUBLIC_SUPABASE_URL,
          import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
          createSupabaseBrowserAuthOptions(localStorage)
        );
        const { data } = await client.auth.getSession();
        if (data.session?.access_token) return data.session.access_token;
      } catch {
        // Fall through to storage compatibility checks.
      }

      return parseStoredAccessToken(ORVEL_SUPABASE_AUTH_STORAGE_KEY)
        || parseStoredAccessToken('orvel.session.v1', 'token');
    };

    const paymentStatus = (params.get('payment_status') || '').trim().toLowerCase();
    const subscriptionState = (params.get('subscription_state') || '').trim().toLowerCase();
    const subscriptionSessionId = (params.get('subscription_session_id') || params.get('preapproval_id') || '').trim();
    if (paymentStatus === 'approved') {
      // UX only: Mercado Pago return query params are hints, not entitlement proof.
      // Backend materialized subscription/account state is required before dashboard handoff.
      setUiState('pending');
    } else if (subscriptionState === 'pending') {
      setUiState('pending');
    } else if (paymentStatus === 'rejected' || paymentStatus === 'failed') {
      setUiState('failed');
    } else if (paymentStatus === 'cancelled' || subscriptionState === 'cancelled') {
      setUiState('cancelled');
    }

    const normalizedSubscriptionError = normalizeSubscriptionErrorCode(subscriptionError);
    if (normalizedSubscriptionError && errorContainer && errorMessages[normalizedSubscriptionError]) {
      showSubscriptionError(normalizedSubscriptionError);
      setUiState(normalizedSubscriptionError === 'subscription_cancelled' ? 'cancelled' : 'retry');
      setSubscriptionButtonDisabled(false);
    }

    const buildSubscriptionLoginHandoffUrl = () => {
      const loginUrl = new URL('/auth/login', window.location.origin);
      loginUrl.searchParams.set('plan', plan);
      loginUrl.searchParams.set('billing', billing);
      loginUrl.searchParams.set('source', 'subscription');
      return loginUrl.toString();
    };

    const subscriptionAttemptKey = subscriptionAttemptStorageKey(plan);
    const readPendingSignupIntent = () => {
      try {
        const rawValue = sessionStorage.getItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent);
        if (!rawValue) return null;
        const parsed = JSON.parse(rawValue);
        return parsed && typeof parsed === 'object' ? parsed : null;
      } catch {
        return null;
      }
    };
    const buildIdempotencyKey = () => {
      const existing = sessionStorage.getItem(subscriptionAttemptKey);
      if (existing) return existing;
      const generated = `landing-${plan}-${crypto.randomUUID()}`;
      sessionStorage.setItem(subscriptionAttemptKey, generated);
      return generated;
    };

    const pollSubscriptionStatus = async () => {
      if (!subscriptionSessionId) return;
      if (TERMINAL_NON_SUCCESS_STATES.has(currentUiState)) {
        stopSubscriptionPolling();
        return;
      }
      pollingAttempts += 1;
      if (pollingAttempts > MAX_POLLING_ATTEMPTS) {
        stopSubscriptionPolling();
        setUiState('retry');
        return;
      }
      try {
        const token = await getSubscriptionAccessToken();
        const headers: Record<string, string> = {};
        if (token) headers.Authorization = `Bearer ${token}`;

        const response = await fetch(`/api/subscriptions/status?subscription_session_id=${encodeURIComponent(subscriptionSessionId)}`, {
          method: 'GET',
          headers
        });
        const result = await response.json().catch(() => null);

        const normalizedStatus = `${result?.status || result?.payment_status || ''}`.toLowerCase();
        const accountMaterialized = result?.account_materialized === true || result?.materialized === true;
        if (normalizedStatus === 'approved' || normalizedStatus === 'active' || accountMaterialized) {
          stopSubscriptionPolling();
          sessionStorage.removeItem(subscriptionAttemptKey);
          const handoffUrl = buildSubscriptionLoginHandoffUrl();
          window.location.href = handoffUrl;
          return;
        }

        if (normalizedStatus === 'rejected' || normalizedStatus === 'failed') {
          setUiState('failed');
          stopSubscriptionPolling();
          setSubscriptionButtonDisabled(false);
          return;
        }

        if (normalizedStatus === 'cancelled' || normalizedStatus === 'canceled') {
          setUiState('cancelled');
          stopSubscriptionPolling();
          setSubscriptionButtonDisabled(false);
          return;
        }

        setUiState('pending');
      } catch {
        setUiState('retry');
      }
    };

    if (subscriptionSessionId) {
      setUiState('pending');
      pollSubscriptionStatus();
      pollingIntervalId = window.setInterval(pollSubscriptionStatus, 4000);
    }
    // Bind subscription button
    const initSubscriptionBtn = document.getElementById('subscriptionContinueBtn');
    if (initSubscriptionBtn) {
      initSubscriptionBtn.addEventListener('click', async () => {
        const recoveryHref = (initSubscriptionBtn as HTMLButtonElement).dataset.recoveryHref;
        if (recoveryHref) {
          window.location.href = recoveryHref;
          return;
        }

        if (errorContainer) {
          errorContainer.textContent = '';
          errorContainer.classList.add('hidden');
        }

        try {
          // Disable button to prevent double submission
          const btnText = initSubscriptionBtn.querySelector('span');
          if (btnText) btnText.textContent = 'Procesando...';
          initSubscriptionBtn.setAttribute('disabled', 'true');

          const token = await getSubscriptionAccessToken();
          const businessType = sessionStorage.getItem(SIGNUP_STORAGE_KEYS.tipoNegocio);
          const pendingSignupIntent = readPendingSignupIntent();
          const pendingSignupPayload = buildPendingSignupIntentPayload(pendingSignupIntent);
          const readiness = getSubscriptionStartReadiness({
            plan,
            billing,
            pendingSignupIntent,
            accessToken: token,
          });

          if (!readiness.ok) {
            sessionStorage.removeItem(subscriptionAttemptKey);
            sessionStorage.removeItem(SIGNUP_STORAGE_KEYS.pendingSignupIntent);
            showSubscriptionError(readiness.code);
            setUiState('retry');
            if (btnText) btnText.textContent = 'Volver al formulario';
            (initSubscriptionBtn as HTMLButtonElement).dataset.recoveryHref = readiness.recoveryHref;
            initSubscriptionBtn.removeAttribute('disabled');
            return;
          }

          delete (initSubscriptionBtn as HTMLButtonElement).dataset.recoveryHref;
          const headers: Record<string, string> = {
            'Content-Type': 'application/json'
          };
          if (token) headers.Authorization = `Bearer ${token}`;

          const response = await fetch('/api/subscriptions/start', {
            method: 'POST',
            headers,
            body: JSON.stringify({ 
              plan, 
              billing,
              billing_period: billing,
              cadence: billing,
              idempotencyKey: buildIdempotencyKey(),
              businessType,
              ...(pendingSignupPayload ? {
                pending_signup_intent: {
                  email_encrypted: pendingSignupPayload.email_encrypted,
                  email_hmac: pendingSignupPayload.email_hmac,
                  first_name_encrypted: pendingSignupPayload.first_name_encrypted,
                  first_name_hmac: pendingSignupPayload.first_name_hmac,
                  last_name_encrypted: pendingSignupPayload.last_name_encrypted,
                  last_name_hmac: pendingSignupPayload.last_name_hmac,
                  phone_encrypted: pendingSignupPayload.phone_encrypted,
                  phone_hmac: pendingSignupPayload.phone_hmac,
                  business_name_encrypted: pendingSignupPayload.business_name_encrypted,
                  business_name_hmac: pendingSignupPayload.business_name_hmac,
                  pii_crypto_version: pendingSignupPayload.pii_crypto_version,
                  plan_code: pendingSignupPayload.plan_code,
                  billing_period: pendingSignupPayload.billing_period,
                  business_type: pendingSignupPayload.business_type,
                  selected_business_types: pendingSignupPayload.selected_business_types
                }
              } : {})
            })
          });
          
          const result = await response.json().catch(() => null);

          if (!response.ok) {
            const codeOrMessage = normalizeSubscriptionErrorCode(result?.error || result?.message) || 'subscription_failed';
            showSubscriptionError(codeOrMessage);
            setUiState(codeOrMessage === 'subscription_cancelled' ? 'cancelled' : 'retry');
            
            // Re-enable button
            if (btnText) btnText.innerHTML = 'Continuar con Mercado Pago <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>';
            initSubscriptionBtn.removeAttribute('disabled');
            return;
          }

          if (result?.init_point) {
            window.location.href = result.init_point;
          } else {
            showSubscriptionError('subscription_error');
            setUiState('retry');
            initSubscriptionBtn.removeAttribute('disabled');
          }
        } catch (error) {
          console.error('Subscription error:', error);
          showSubscriptionError('subscription_retry');
          setUiState('retry');
          initSubscriptionBtn.removeAttribute('disabled');
        }
      });
    }
  }
</script>
