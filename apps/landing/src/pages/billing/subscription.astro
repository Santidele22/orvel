---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Orvel - Transferí y mandá el comprobante">
  <main class="min-h-screen bg-[#0A0E1B] text-[#F3F1FA] font-body">
    <div class="mx-auto max-w-lg px-6 py-12">
      <section class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#141A2C] p-6 shadow-2xl sm:p-8">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(124,92,255,0.22),transparent_45%)]"></div>
        <div class="relative z-10 space-y-6">
          <div class="inline-flex items-center rounded-full border border-[#7C5CFF]/40 bg-[#7C5CFF]/15 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9B7BFF]">
            PASO FINAL
          </div>

          <h1 class="font-headline text-3xl font-black tracking-tight text-white">
            Transferí y mandá el comprobante
          </h1>

          <article class="rounded-xl border border-[#7C5CFF]/40 bg-[#0A0E1B]/70 p-5">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[#9096AE]">PLAN PREMIUM</p>
              <span class="rounded-full bg-[#7C5CFF]/20 px-2 py-1 text-[10px] font-semibold text-[#9B7BFF]">Pago pendiente</span>
            </div>
            <p class="text-2xl font-black text-white">$25.000/mes</p>
            <ul class="mt-4 space-y-2 text-sm text-[#F3F1FA]">
              <li>Turnos ilimitados</li>
              <li>1 local</li>
            </ul>
          </article>

          <div class="rounded-xl border border-white/10 bg-[#0A0E1B] p-4">
            <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#9096AE]">TRANSFERÍ A ESTE ALIAS</p>
            <div class="flex items-center justify-between gap-3">
              <code id="premiumAliasValue" class="text-lg font-bold tracking-wide text-white">orvel.pagos</code>
              <button
                id="copyAliasBtn"
                type="button"
                class="rounded-full bg-[#7C5CFF] px-4 py-2 text-xs font-bold uppercase tracking-widest text-white"
              >
                Copiar
              </button>
            </div>
          </div>

          <ol class="space-y-3 text-sm text-[#C9CCDA]">
            <li>1. Transferí los $25.000 al alias de arriba.</li>
            <li>2. Mandá el comprobante por WhatsApp.</li>
            <li>3. Entrá ya en Gratis, sin esperar a nadie.</li>
            <li>4. Cuando lo validemos, pasás a Premium y te llega un mail.</li>
          </ol>

          <a
            id="premiumWhatsAppCta"
            href="https://wa.me/5492944667161?text=Hola%2C%20te%20mando%20el%20comprobante%20de%20Premium%20Orvel%20(%2425.000).%20Alias%20orvel.pagos."
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-[#7C5CFF] to-[#5B3DE0] py-4 px-6 text-sm font-bold text-white shadow-lg shadow-[#7C5CFF]/30"
          >
            Enviar comprobante por WhatsApp
          </a>

          <p class="text-center text-xs font-medium text-[#9096AE]">
            Hasta entonces tu cuenta funciona en plan Gratis.
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { copyPremiumAlias, markPremiumReviewPending } from '../../lib/premium-alias-receipt';

  if (typeof window !== 'undefined') {
    markPremiumReviewPending(window.localStorage);

    const copyBtn = document.getElementById('copyAliasBtn');
    copyBtn?.addEventListener('click', async () => {
      const copied = await copyPremiumAlias();
      if (!copied || !copyBtn) return;
      const previous = copyBtn.textContent;
      copyBtn.textContent = 'Copiado';
      window.setTimeout(() => {
        copyBtn.textContent = previous || 'Copiar';
      }, 2000);
    });
  }
</script>
