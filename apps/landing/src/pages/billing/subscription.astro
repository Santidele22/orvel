---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Orvel - Transferí y mandá el comprobante">
  <main class="min-h-screen bg-[#0A0E1B] text-[#F3F1FA] font-body">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <header class="mb-8 max-w-2xl">
        <div class="mb-4 inline-flex items-center rounded-full border border-[#7C5CFF]/40 bg-[#7C5CFF]/15 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9B7BFF]">
          PASO FINAL
        </div>
        <h1 class="font-headline text-3xl font-black tracking-tight text-white sm:text-4xl">
          Transferí y mandá el comprobante
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-6 text-[#C9CCDA] sm:text-base">
          No usamos Mercado Pago ni tarjeta. Es una transferencia directa que validamos a mano.
        </p>
      </header>

      <div class="grid items-start gap-5 md:grid-cols-2">
        <article class="rounded-2xl border border-[#7C5CFF]/40 bg-[#141A2C] p-6">
          <div class="mb-3 flex items-center justify-between gap-3">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[#9096AE]">PLAN PREMIUM</p>
            <span class="rounded-full border border-[#FBBF24] px-2 py-1 text-[10px] font-semibold text-[#FBBF24]">Pago pendiente</span>
          </div>
          <p class="text-3xl font-black text-white">$25.000/mes</p>
          <ul class="mt-5 space-y-3 text-sm text-[#F3F1FA]">
            <li class="flex items-center gap-3">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#7C5CFF]/20 text-xs font-bold text-[#9B7BFF]">✓</span>
              Turnos ilimitados
            </li>
            <li class="flex items-center gap-3">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#7C5CFF]/20 text-xs font-bold text-[#9B7BFF]">✓</span>
              1 local
            </li>
          </ul>
        </article>

        <section class="rounded-2xl bg-[#141A2C] p-6">
          <div class="rounded-xl border border-dashed border-[#7C5CFF]/55 bg-[#0A0E1B] p-4">
            <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#9096AE]">TRANSFERÍ A ESTE ALIAS</p>
            <div class="flex items-center justify-between gap-3">
              <code id="premiumAliasValue" class="text-lg font-bold tracking-wide text-white">orvel.pagos</code>
              <button
                id="copyAliasBtn"
                type="button"
                class="rounded-full bg-[#7C5CFF] px-4 py-2 text-xs font-bold uppercase tracking-widest text-white"
              >
                Copiar
              </button>
            </div>
          </div>

          <ol class="mt-5 space-y-3 text-sm text-[#C9CCDA]">
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#7C5CFF] text-xs font-extrabold text-white">1</span>
              Transferí los $25.000 al alias de arriba.
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#7C5CFF] text-xs font-extrabold text-white">2</span>
              Mandá el comprobante por WhatsApp.
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#7C5CFF] text-xs font-extrabold text-white">3</span>
              Entrá ya en Gratis, sin esperar a nadie.
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#7C5CFF] text-xs font-extrabold text-white">4</span>
              Cuando lo validemos, pasás a Premium y te llega un mail.
            </li>
          </ol>

          <a
            id="premiumWhatsAppCta"
            href="https://wa.me/5492944667161?text=Hola%2C%20te%20mando%20el%20comprobante%20de%20Premium%20Orvel%20(%2425.000).%20Alias%20orvel.pagos."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 flex w-full items-center justify-center rounded-full bg-gradient-to-r from-[#7C5CFF] to-[#5B3DE0] py-4 px-6 text-sm font-bold text-white shadow-lg shadow-[#7C5CFF]/30"
          >
            Enviar comprobante por WhatsApp
          </a>

          <p class="mt-3 text-center text-xs font-medium text-[#9096AE]">
            Hasta entonces tu cuenta funciona en plan Gratis.
          </p>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { copyPremiumAlias, markPremiumReviewPending } from '../../lib/premium-alias-receipt';

  if (typeof window !== 'undefined') {
    markPremiumReviewPending(window.localStorage);

    const copyBtn = document.getElementById('copyAliasBtn');
    copyBtn?.addEventListener('click', async () => {
      const copied = await copyPremiumAlias();
      if (!copied || !copyBtn) return;
      const previous = copyBtn.textContent;
      copyBtn.textContent = 'Copiado';
      window.setTimeout(() => {
        copyBtn.textContent = previous || 'Copiar';
      }, 2000);
    });
  }
</script>
