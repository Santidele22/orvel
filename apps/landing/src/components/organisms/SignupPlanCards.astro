---
import SignupPlanCard from "../molecules/SignupPlanCard.astro";

export interface Props {
  plansWithBilling: any[];
}

const { plansWithBilling } = Astro.props;
---

<script define:vars={{ plansData: plansWithBilling }}>
// Store plans data for client-side use
const PLANS_DATA = plansData;

// Update prices based on billing period
function updatePrices(period) {
  // Update button states
  document.querySelectorAll('.billing-option').forEach(btn => {
    if (btn.dataset.billing === period) {
      btn.classList.add('bg-primary', 'text-on-secondary');
      btn.classList.remove('text-text-primary');
    } else {
      btn.classList.remove('bg-primary', 'text-on-secondary');
      btn.classList.add('text-text-primary');
    }
  });

  const plansContainer = document.getElementById('plans-container');
  if (period !== 'monthly') {
    if (plansContainer) {
      plansContainer.classList.remove('md:grid-cols-4');
      plansContainer.classList.add('md:grid-cols-3', 'max-w-4xl', 'mx-auto');
    }
  } else {
    if (plansContainer) {
      plansContainer.classList.remove('md:grid-cols-3', 'max-w-4xl', 'mx-auto');
      plansContainer.classList.add('md:grid-cols-4');
    }
  }

  // Update all price displays and hrefs
  document.querySelectorAll('.plan-card').forEach(card => {
    const planCode = card.dataset.planCode;
    const plan = PLANS_DATA.find(p => p.code === planCode);
    if (!plan) return;

    // Update href to include billing period
    card.href = `/auth/signup/credentials?plan=${planCode}&billing=${period}`;

    // Hide FREE plan if not monthly
    if (planCode === 'FREE') {
      if (period !== 'monthly') {
        card.classList.add('hidden');
      } else {
        card.classList.remove('hidden');
      }
      return;
    }

    let price = 0;
    let savings = 0;
    let billingLabel = '';

    switch (period) {
      case 'monthly':
        price = plan.price;
        billingLabel = '/mes';
        break;
      case 'quarterly':
        price = plan.quarterly_price;
        billingLabel = '/trimestre';
        savings = (plan.price * 3) - plan.quarterly_price;
        break;
      case 'annual':
        price = plan.annual_price;
        billingLabel = '/año';
        savings = (plan.price * 12) - plan.annual_price;
        break;
    }

    const priceEl = card.querySelector('.price-value');
    const labelEl = card.querySelector('.price-label');
    const savingsEl = card.querySelector('.price-savings');
    const savingsAmountEl = card.querySelector('.savings-amount');

    if (priceEl) priceEl.textContent = new Intl.NumberFormat('es-AR').format(price);
    if (labelEl) labelEl.textContent = billingLabel;
    
    if (savings > 0 && savingsEl && savingsAmountEl) {
      savingsAmountEl.textContent = new Intl.NumberFormat('es-AR').format(savings);
      savingsEl.classList.remove('hidden');
    } else if (savingsEl) {
      savingsEl.classList.add('hidden');
    }
  });
}

// Initialize billing toggle
document.addEventListener('DOMContentLoaded', () => {
  updatePrices('monthly');

  // Billing toggle handlers
  document.querySelectorAll('.billing-option').forEach(btn => {
    btn.addEventListener('click', () => {
      updatePrices(btn.dataset.billing);
    });
  });
});
</script>

<!-- Billing Toggle -->
<div class="flex justify-center mb-6 mt-8 w-full overflow-x-auto pb-2 scrollbar-hide">
  <div class="bg-bg-primary rounded-full p-1 sm:p-1.5 flex items-center gap-1 border border-border shadow-sm min-w-max mx-auto">
    <button class="billing-option px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-[10px] sm:text-xs font-headline font-bold tracking-wide transition-all bg-primary text-on-secondary whitespace-nowrap" data-billing="monthly">Mensual</button>
    <button class="billing-option px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-[10px] sm:text-xs font-headline font-bold tracking-wide transition-all text-text-primary hover:bg-bg-secondary whitespace-nowrap" data-billing="quarterly">Trimestral (-15%)</button>
    <button class="billing-option px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-[10px] sm:text-xs font-headline font-bold tracking-wide transition-all text-text-primary hover:bg-bg-secondary whitespace-nowrap" data-billing="annual">Anual (-30%) <span class="text-primary text-[9px]">🔥</span></button>
  </div>
</div>

<!-- Plans -->
<section class="grid grid-cols-1 md:grid-cols-4 gap-6 transition-all duration-300" id="plans-container">
  {plansWithBilling.map((plan) => (
    <SignupPlanCard plan={plan} />
  ))}
</section>
