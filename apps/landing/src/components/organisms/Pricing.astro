---
// Organism: Pricing Section
// Plans with billing toggle
interface Plan {
  code: string;
  name: string;
  price: number;
  quarterly_price: number;
  annual_price: number;
  duration_days: number;
  is_featured: boolean;
  description?: string;
}

interface Props {
  plansWithBilling: Plan[];
}

const { plansWithBilling } = Astro.props;

import PlanCard from '../molecules/PlanCard.astro';
---

<section class="relative overflow-hidden py-24 md:py-32 bg-bg-primary" id="pricing">
  <div class="absolute inset-x-0 top-24 mx-auto h-72 w-72 rounded-full bg-primary/10 blur-[110px] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-8 md:px-12 relative z-10">
    <div class="text-center mb-12">
      <div class="inline-block px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-[10px] font-bold tracking-widest uppercase text-primary mb-4 shadow-sm">Precios claros</div>
      <h2 class="text-4xl md:text-5xl font-headline font-bold tracking-tighter text-text-primary mb-4">Llená tu agenda sin esfuerzo</h2>
      <p class="text-lg text-text-primary/70 max-w-3xl mx-auto">Más turnos, menos cancelaciones. Elegí el plan que acompaña tu crecimiento. Todos los planes incluyen 1 local.</p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-10">
      <div class="bg-bg-primary rounded-full p-1.5 flex items-center gap-1 border border-border">
        <button class="billing-option px-6 py-2.5 rounded-full text-xs font-headline font-bold tracking-wide transition-all bg-primary text-on-secondary" data-billing="monthly">Mensual</button>
        <button class="billing-option px-6 py-2.5 rounded-full text-xs font-headline font-bold tracking-wide transition-all text-text-primary" data-billing="quarterly">Trimestral (-15%)</button>
        <button class="billing-option px-6 py-2.5 rounded-full text-xs font-headline font-bold tracking-wide transition-all text-text-primary" data-billing="annual">Anual (-30%) <span class="text-primary text-[9px]">🔥</span></button>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row flex-wrap justify-center items-stretch gap-6">
      {plansWithBilling.filter(p => p.code !== 'FREE').map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

    <div class="mt-10 mx-auto max-w-5xl rounded-[28px] border border-primary/30 bg-[linear-gradient(135deg,rgba(124,58,237,0.16),rgba(18,18,18,0.82))] p-6 md:p-8 shadow-2xl shadow-primary/10 backdrop-blur-sm">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.22em] text-primary-light">
            <span class="h-2 w-2 rounded-full bg-primary"></span>
            Add-on
          </div>
          <h3 class="font-headline text-2xl md:text-3xl font-black tracking-tight text-text-primary">Multi-sucursal</h3>
          <p class="mt-3 text-sm md:text-base text-text-secondary max-w-xl">Sumá sucursales a tu cuenta Orvel y gestioná cada local desde una misma experiencia, sin cambiar tu plan base.</p>
          <p class="mt-3 text-xs font-semibold text-text-secondary/80">Los planes base incluyen 1 local.</p>
        </div>

        <div class="shrink-0 rounded-2xl border border-white/10 bg-bg-primary/70 p-5 md:min-w-[280px]">
          <p class="text-[10px] font-bold uppercase tracking-widest text-text-secondary">Local adicional</p>
          <p class="mt-2 font-headline text-3xl md:text-4xl font-black text-text-primary"><span class="text-primary-light">+$20.000</span><span class="ml-1 text-sm font-body font-normal text-text-secondary">/mes</span></p>
          <a href="/auth/login?returnTo=/billing/subscription" class="mt-5 inline-flex w-full items-center justify-center rounded-full border border-primary/35 bg-white/5 px-5 py-3 text-xs font-headline font-bold uppercase tracking-wide text-text-primary transition-all hover:border-primary hover:bg-primary/15">
            Consultar multi-sucursal
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
