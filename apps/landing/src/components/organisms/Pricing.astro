---
// Organism: Pricing Section
// Plans with billing toggle
interface Plan {
  code: string;
  name: string;
  price: number;
  quarterly_price: number;
  annual_price: number;
  duration_days: number;
  is_featured: boolean;
  description?: string;
}

interface Props {
  plansWithBilling: Plan[];
}

const { plansWithBilling } = Astro.props;

import PlanCard from '../molecules/PlanCard.astro';
---

<section class="relative overflow-hidden py-24 md:py-32 bg-bg-primary" id="pricing">
  <div class="absolute inset-x-0 top-24 mx-auto h-72 w-72 rounded-full bg-primary/10 blur-[110px] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-8 md:px-12 relative z-10">
    <div class="text-center mb-12">
      <div class="inline-block px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-[10px] font-bold tracking-widest uppercase text-primary mb-4 shadow-sm">Precios claros</div>
      <h2 class="text-4xl md:text-5xl font-headline font-bold tracking-tighter text-text-primary mb-4">Llená tu agenda sin esfuerzo</h2>
      <p class="text-lg text-text-primary/70 max-w-3xl mx-auto">Más turnos, menos cancelaciones. Elegí el plan que acompaña tu crecimiento. Todos los planes incluyen 1 local.</p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-10 w-full overflow-x-auto pb-2 scrollbar-hide" aria-label="Elegir frecuencia de facturación">
      <div class="bg-bg-primary rounded-full p-1 sm:p-1.5 flex items-center gap-1 border border-border shadow-sm min-w-max mx-auto">
        <button type="button" aria-pressed="true" class="billing-option px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-[10px] sm:text-xs font-headline font-bold tracking-wide transition-all bg-primary text-on-secondary whitespace-nowrap" data-billing="monthly">Mensual</button>
        <button type="button" aria-pressed="false" class="billing-option px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-[10px] sm:text-xs font-headline font-bold tracking-wide transition-all text-text-primary hover:bg-bg-secondary whitespace-nowrap" data-billing="quarterly">Trimestral (-15%)</button>
        <button type="button" aria-pressed="false" class="billing-option px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-[10px] sm:text-xs font-headline font-bold tracking-wide transition-all text-text-primary hover:bg-bg-secondary whitespace-nowrap" data-billing="annual">Anual (-30%) <span class="text-primary text-[9px]">🔥</span></button>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row flex-wrap justify-center items-stretch gap-6">
      {plansWithBilling.map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

  </div>
</section>
