---
const panels = [
  {
    id: 'agenda',
    tab: 'Agenda',
    headline: 'Gestioná tu agenda sin complicaciones',
    body: 'Los turnos del día, los horarios y los bloqueos viven juntos. Lo ocupado no se ofrece.',
    bullets: [
      'Vista de turnos confirmados, a la hora que toca',
      'Horarios y bloqueos para cuidar la disponibilidad real'
    ]
  },
  {
    id: 'clientes',
    tab: 'Clientes',
    headline: 'Conocé a tus clientes',
    body: 'Nombre, celular y el historial de turnos. Lo justo para atender, sin armar un sistema aparte.',
    bullets: [
      'Datos de contacto de quien reserva',
      'Historial de turnos para saber quién ya vino'
    ]
  }
] as const;
---

<section
  class="landing-section bg-bg-primary"
  id="en-un-solo-lugar"
  data-product-showcase
>
  <div class="landing-container">
    <div class="text-center landing-section-header">
      <div class="landing-eyebrow border border-border bg-white/5 text-text-primary mb-4">En un solo lugar</div>
      <h2 class="landing-title font-headline font-bold text-text-primary mb-4 reveal">
        Agenda y clientes. <span class="italic font-light">Juntos.</span>
      </h2>
      <p class="landing-lead text-text-secondary font-body mx-auto reveal stagger-1">
        Turnos, clientes, horarios y bloqueos en un mismo sistema. Lo que está libre se ve. Lo ocupado no se ofrece.
      </p>
    </div>

    <div class="flex justify-center mb-10 reveal">
      <div
        class="inline-flex rounded-full border border-border bg-white/5 p-1"
        role="tablist"
        aria-label="Superficies del producto"
      >
        {panels.map((panel, index) => (
          <button
            type="button"
            id={`product-tab-${panel.id}`}
            class:list={[
              'rounded-full px-5 py-2 text-sm font-headline font-semibold',
              index === 0 ? 'bg-white text-bg-primary' : 'text-text-secondary'
            ]}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`product-panel-${panel.id}`}
            data-product-tab={panel.id}
          >
            {panel.tab}
          </button>
        ))}
      </div>
    </div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-center">
      <div>
        {panels.map((panel, index) => (
          <div
            id={`product-panel-${panel.id}`}
            class:list={['landing-card p-6 md:p-8', index !== 0 && 'hidden']}
            role="tabpanel"
            aria-labelledby={`product-tab-${panel.id}`}
            data-product-copy={panel.id}
            hidden={index !== 0}
          >
            <h3 class="font-headline italic font-bold text-text-primary text-2xl mb-3">{panel.headline}</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-5">{panel.body}</p>
            <ul class="space-y-3">
              {panel.bullets.map((bullet) => (
                <li class="flex items-start gap-3 text-sm text-text-primary">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
                    <i class="ri-check-line text-sm" aria-hidden="true"></i>
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="relative mx-auto w-full max-w-xl reveal">
        <div
          class="overflow-hidden rounded-2xl border border-white/10 bg-[#121218] shadow-2xl"
          data-product-desktop
        >
          <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            <p class="ml-3 flex-1 rounded-full bg-white/5 px-3 py-1 text-[11px] text-text-secondary">
              orvel.pro
            </p>
          </div>

          <div data-product-surface="agenda">
            <div class="grid grid-cols-[88px_1fr] gap-px bg-white/5 p-4 text-left">
              <div class="rounded-l-xl bg-[#1a1a22] p-3 text-[11px] text-text-secondary">
                <p class="font-headline font-semibold text-text-primary mb-2">Hoy</p>
                <p>10:00</p>
                <p class="mt-3">15:30</p>
                <p class="mt-3">16:30</p>
              </div>
              <div class="space-y-2 rounded-r-xl bg-[#1a1a22] p-3">
                <p class="text-[11px] uppercase tracking-[0.14em] text-primary">Agenda</p>
                <article class="rounded-xl border border-white/10 bg-white/5 p-3">
                  <p class="text-sm font-headline font-semibold text-text-primary">Bloqueo · almuerzo</p>
                  <p class="text-[11px] text-text-secondary">10:00 · 30 min</p>
                </article>
                <article class="rounded-xl border border-primary/30 bg-primary/10 p-3">
                  <p class="text-sm font-headline font-semibold text-text-primary">Corte clásico · Ana</p>
                  <p class="text-[11px] text-text-secondary">15:30 · Confirmado</p>
                </article>
                <article class="rounded-xl border border-white/10 bg-white/5 p-3">
                  <p class="text-sm font-headline font-semibold text-text-primary">Color · Luis</p>
                  <p class="text-[11px] text-text-secondary">16:30 · Confirmado</p>
                </article>
              </div>
            </div>
          </div>

          <div class="hidden" data-product-surface="clientes" hidden>
            <div class="p-4 space-y-2">
              <p class="text-[11px] uppercase tracking-[0.14em] text-primary">Clientes</p>
              <article class="rounded-xl border border-primary/30 bg-primary/10 p-3">
                <p class="text-sm font-headline font-semibold text-text-primary">Ana López</p>
                <p class="text-[11px] text-text-secondary">11 5555-2030 · último turno: corte</p>
              </article>
              <article class="rounded-xl border border-white/10 bg-white/5 p-3">
                <p class="text-sm font-headline font-semibold text-text-primary">Luis Pérez</p>
                <p class="text-[11px] text-text-secondary">11 4444-1188 · último turno: color</p>
              </article>
              <article class="rounded-xl border border-white/10 bg-white/5 p-3">
                <p class="text-sm font-headline font-semibold text-text-primary">María Díaz</p>
                <p class="text-[11px] text-text-secondary">11 3333-9090 · 4 turnos</p>
              </article>
            </div>
          </div>
        </div>

        <div
          class="absolute -bottom-8 -right-2 w-[148px] sm:w-[168px]"
          data-product-phone
        >
          <div class="rounded-[1.6rem] border border-white/15 bg-[#1a1a22] p-1.5 shadow-2xl">
            <div class="overflow-hidden rounded-[1.25rem] bg-[#f4f4f5] text-zinc-900">
              <div class="px-3 pt-2 pb-1 flex items-center justify-between text-[9px] text-zinc-500">
                <span>10:37</span>
                <span class="h-3 w-10 rounded-full bg-zinc-900/80"></span>
                <span>Orvel</span>
              </div>
              <div data-product-phone-surface="agenda">
                <div class="px-3 pb-3">
                  <p class="text-[10px] text-zinc-500">Hoy</p>
                  <p class="font-headline font-bold text-xs text-zinc-900">Agenda</p>
                  <article class="mt-2 rounded-xl bg-white p-2 shadow-sm">
                    <p class="text-[10px] text-primary font-semibold">15:30</p>
                    <p class="text-xs font-headline font-semibold">Ana · Corte</p>
                  </article>
                </div>
              </div>
              <div class="hidden" data-product-phone-surface="clientes" hidden>
                <div class="px-3 pb-3">
                  <p class="text-[10px] text-zinc-500">Ficha</p>
                  <p class="font-headline font-bold text-xs text-zinc-900">Ana López</p>
                  <article class="mt-2 rounded-xl bg-white p-2 shadow-sm">
                    <p class="text-[10px] text-zinc-500">Último turno</p>
                    <p class="text-xs font-headline font-semibold">Corte · 2 jun</p>
                  </article>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-12 text-center text-[11px] text-text-secondary">Vista de ejemplo. Screenshots reales después.</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-product-showcase]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-product-tab]'));

    function showSurface(surface: string): void {
      tabs.forEach((tab) => {
        const active = tab.dataset.productTab === surface;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.classList.toggle('bg-white', active);
        tab.classList.toggle('text-bg-primary', active);
        tab.classList.toggle('text-text-secondary', !active);
      });

      root.querySelectorAll<HTMLElement>('[data-product-copy]').forEach((panel) => {
        const match = panel.dataset.productCopy === surface;
        panel.classList.toggle('hidden', !match);
        panel.toggleAttribute('hidden', !match);
      });

      root.querySelectorAll<HTMLElement>('[data-product-surface]').forEach((panel) => {
        const match = panel.dataset.productSurface === surface;
        panel.classList.toggle('hidden', !match);
        panel.toggleAttribute('hidden', !match);
      });

      root.querySelectorAll<HTMLElement>('[data-product-phone-surface]').forEach((panel) => {
        const match = panel.dataset.productPhoneSurface === surface;
        panel.classList.toggle('hidden', !match);
        panel.toggleAttribute('hidden', !match);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const surface = tab.dataset.productTab;
        if (surface) showSurface(surface);
      });
    });
  }
</script>
