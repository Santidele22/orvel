---
// Prelaunch header: login and signup, no waitlist CTA.
---

<header class="fixed top-0 left-0 right-0 z-50 bg-bg-primary/80 backdrop-blur-xl border-b border-border h-16">
  <div class="landing-container flex items-center justify-between h-full gap-4">
    <a href="/" aria-label="Orvel" class="flex items-center gap-2">
      <img src="/logo-white.png" alt="Orvel" class="h-8 md:h-10 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Navegación principal">
      <a class="text-text-secondary hover:text-text-primary font-headline text-sm font-medium tracking-wide transition-colors" href="#producto">Producto</a>
      <a class="text-text-secondary hover:text-text-primary font-headline text-sm font-medium tracking-wide transition-colors" href="#rubros">Rubros</a>
      <a class="text-text-secondary hover:text-text-primary font-headline text-sm font-medium tracking-wide transition-colors" href="#precios">Precios</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/auth/login" class="text-text-secondary hover:text-text-primary font-headline font-bold text-[11px] uppercase tracking-widest transition-colors">
        Iniciar sesión
      </a>
      <a href="/auth/signup/plan" class="btn btn-primary px-5 py-2 text-xs tracking-widest uppercase">
        Crear cuenta
      </a>
    </div>
  </div>
</header>
