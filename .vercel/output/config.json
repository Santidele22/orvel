{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/start/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/status/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/oauth/onboarding-callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/signup/business-type/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/signup/complete/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/signup/credentials/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/signup/plan/?$",
			"dest": "_render"
		},
		{
			"src": "^/billing/test-checkout/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}