---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Orvel - Registrá tu cuenta">
  <main class="flex min-h-screen w-full bg-bg-primary">
    <!-- Left Side: Imagery -->
    <section class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-bg-secondary flex-col justify-end p-12 lg:p-24">
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-bg-primary via-bg-primary/20 to-transparent opacity-90"></div>
      <img src="/banner3.png" alt="Orvel Dashboard" class="absolute inset-0 w-full h-full object-cover scale-110 blur-[1px] opacity-70" />
      
      <div class="relative z-20 space-y-4">
        <div class="inline-block px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-[10px] font-bold tracking-widest uppercase text-primary mb-2 shadow-sm">Paso 2 de 3</div>
        <h2 class="text-4xl lg:text-5xl font-headline font-bold text-text-primary leading-[1.1] max-w-md">
          Estás a un paso de automatizar tu negocio.
        </h2>
        <p class="text-text-secondary text-lg font-body max-w-sm">
            Creá tu perfil y configurá tu espacio de trabajo profesional.
        </p>
      </div>
    </section>

    <!-- Right Side: Credentials Form -->
    <section class="w-full lg:w-1/2 flex flex-col justify-center px-8 sm:px-16 lg:px-24 relative z-10">
      <div class="max-w-md w-full mx-auto md:mx-0 lg:ml-0">
        
        <header class="mb-10">
          <!-- Step indicator -->
          <div class="flex items-center gap-4 mb-8">
            <a href="/auth/signup/plan" class="w-8 h-8 rounded-full border border-primary bg-primary/10 flex items-center justify-center text-xs text-primary font-bold">1</a>
            <div class="w-8 h-[2px] bg-primary"></div>
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-xs text-on-secondary font-bold shadow-lg shadow-primary/20">2</div>
            <div class="w-8 h-[2px] bg-border"></div>
            <div class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-xs text-text-secondary">3</div>
          </div>

          <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tighter text-text-primary mb-2 leading-[1.1]">
            Tus datos.
          </h1>
          <p class="text-text-secondary text-base font-body">
            Configurá tus credenciales de acceso.
          </p>
        </header>

        <form id="credentialsForm" class="space-y-6" novalidate>
          <button type="button" id="googleSignupBtn" class="flex items-center justify-center gap-3 w-full btn btn-secondary py-4 rounded-full uppercase tracking-widest text-xs">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Registrarse con Google
          </button>

          <div class="relative flex items-center py-2">
            <div class="flex-grow border-t border-border"></div>
            <span class="flex-shrink-0 mx-4 text-[10px] font-headline uppercase tracking-[0.2em] text-text-secondary">O COMPLETÁ EL FORMULARIO</span>
            <div class="flex-grow border-t border-border"></div>
          </div>
          
          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Nombre Completo</label>
            <input id="name" name="name" type="text" autocomplete="off" required class="input" placeholder="Nombre y Apellido" />
            <p id="error-name" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Nombre del Negocio</label>
            <input id="negocioNombre" name="negocioNombre" type="text" autocomplete="off" required class="input" placeholder="Tu marca o local" />
            <p id="error-negocioNombre" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Teléfono</label>
            <input id="telefono" name="telefono" type="tel" autocomplete="off" required class="input" placeholder="+54 9 11 ..." />
            <p id="error-telefono" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="group">
            <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Email</label>
            <input id="email" name="email" type="email" autocomplete="off" required class="input" placeholder="ejemplo@negocio.com" />
            <p id="error-email" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="group">
              <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Contraseña</label>
              <input id="password" name="password" type="password" autocomplete="new-password" required class="input" placeholder="•••••••••" />
              <p id="error-password" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
            </div>
            <div class="group">
              <label class="block text-[10px] uppercase tracking-[0.2em] text-text-secondary mb-2 ml-1">Confirmar</label>
              <input id="confirmPassword" name="confirm" type="password" autocomplete="new-password" required class="input" placeholder="•••••••••" />
              <p id="error-confirm" class="hidden text-error text-[10px] mt-1 ml-1 animate-in fade-in slide-in-from-top-1" role="alert"></p>
            </div>
          </div>

          <p id="signupError" class="hidden text-xs text-error font-medium" aria-live="polite"></p>

          <footer class="pt-8 flex items-center justify-between">
            <a id="backLink" href="/auth/signup/plan" class="text-[10px] uppercase tracking-[0.2em] text-text-secondary hover:text-text-primary transition-colors flex items-center gap-2">
              <span>←</span> Atrás
            </a>
            <button type="submit" class="btn btn-primary py-4 px-10 rounded-full uppercase tracking-widest text-xs shadow-xl shadow-primary/20">
              Continuar
            </button>
          </footer>
        </form>

        <p class="mt-12 text-[10px] text-text-secondary/50 font-body leading-relaxed uppercase tracking-wider">
          Al continuar, aceptás nuestros términos de servicio y políticas de privacidad. Tus datos están protegidos y cifrados.
        </p>

      </div>
    </section>
  </main>
</Layout>

<script>
  import { createSupabaseSignupAdapterFromEnv, signupWithProvider } from '../../../lib/auth-provider';

  if (typeof window !== 'undefined') {
    const searchParams = new URLSearchParams(window.location.search);
    const plan = searchParams.get('plan') || sessionStorage.getItem('orvel.signup.plan') || 'FREE';
    sessionStorage.setItem('orvel.signup.plan', plan);

    const backLink = document.getElementById('backLink') as HTMLAnchorElement;
    if (backLink) {
      backLink.href = '/auth/signup/plan';
    }

    // Pre-fill email from modal if available
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const storedEmail = sessionStorage.getItem('orvel.signup.email');
    if (emailInput && storedEmail) {
      emailInput.value = storedEmail;
    }

    const oauthErrorCode = searchParams.get('oauth_error_code');
    if (oauthErrorCode) {
      const errorEl = document.getElementById('signupError');
      const diagnosticMessage = `No pudimos completar Google OAuth. Volvé a intentar. Código: ${oauthErrorCode}`;
      if (errorEl) {
        errorEl.textContent = diagnosticMessage;
        errorEl.classList.remove('hidden');
      }
    }

    // --- Validation Engine ---
    const form = document.getElementById('credentialsForm') as HTMLFormElement;

    const validators = {
      name: (val: string) => {
        if (!val) return 'El nombre es requerido';
        if (!val.trim().includes(' ')) return 'Ingresá nombre y apellido';
        return '';
      },
      negocioNombre: (val: string) => {
        if (!val) return 'El nombre del negocio es requerido';
        if (val.length < 3) return 'Debe tener al menos 3 caracteres';
        return '';
      },
      telefono: (val: string) => {
        if (!val) return 'El teléfono es requerido';
        const phoneRegex = /^[+]?[(]?[0-9]{3}[)]?[-\s.]?[0-9]{3}[-\s.]?[0-9]{4,6}$/;
        if (!phoneRegex.test(val.replace(/\s/g, ''))) return 'Formato de teléfono inválido';
        return '';
      },
      email: (val: string) => {
        if (!val) return 'El email es requerido';
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(val)) return 'Ingresá un email válido';
        return '';
      },
      password: (val: string) => {
        if (!val) return 'La contraseña es requerida';
        if (val.length < 8) return 'Mínimo 8 caracteres';
        return '';
      },
      confirm: (val: string, allVals: any) => {
        if (!val) return 'Confirmá tu contraseña';
        if (val !== allVals.password) return 'Las contraseñas no coinciden';
        return '';
      }
    };

    const validateField = (input: HTMLInputElement) => {
      const fieldName = input.name as keyof typeof validators;
      const validator = validators[fieldName];
      if (!validator) return true;

      const allVals = {
        password: (document.getElementById('password') as HTMLInputElement)?.value
      };

      const errorMsg = validator(input.value, allVals);
      const errorEl = document.getElementById(`error-${fieldName === 'confirm' ? 'confirm' : fieldName}`);
      
      if (errorMsg) {
        if (errorEl) {
          errorEl.textContent = errorMsg;
          errorEl.classList.remove('hidden');
        }
        input.classList.add('border-error', 'bg-error/5');
        return false;
      } else {
        if (errorEl) {
          errorEl.classList.add('hidden');
        }
        input.classList.remove('border-error', 'bg-error/5');
        return true;
      }
    };

    const validateForm = () => {
      const inputs = form.querySelectorAll('input');
      let isValid = true;
      inputs.forEach(input => {
        if (!validateField(input)) isValid = false;
      });
      return isValid;
    };

    form.querySelectorAll('input').forEach(input => {
      input.addEventListener('input', () => validateField(input));
      input.addEventListener('blur', () => validateField(input));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      
      if (!validateForm()) {
        return;
      }

      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const errorEl = document.getElementById('signupError');

      const name = (form.querySelector<HTMLInputElement>('input[name="name"]')?.value ?? '').trim();
      const negocioNombre = (form.querySelector<HTMLInputElement>('input[name="negocioNombre"]')?.value ?? '').trim();
      const telefono = (form.querySelector<HTMLInputElement>('input[name="telefono"]')?.value ?? '').trim();
      const email = (form.querySelector<HTMLInputElement>('input[name="email"]')?.value ?? '').trim();
      const password = (form.querySelector<HTMLInputElement>('input[name="password"]')?.value ?? '');
      const confirmPassword = (form.querySelector<HTMLInputElement>('input[name="confirm"]')?.value ?? '');

      if (!button) return;

      if (errorEl) {
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }

      const nameParts = name.split(' ');
      const nombre = nameParts[0] || '';
      const apellido = nameParts.slice(1).join(' ') || '';

      button.disabled = true;
      button.textContent = 'Procesando...';

      const supabaseSignup = createSupabaseSignupAdapterFromEnv({
        SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
        SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      });

      const result = await signupWithProvider({
        attempt: {
          plan,
          nombre,
          apellido,
          negocioNombre,
          telefono,
          tipoNegocio: 'pendiente',
          email,
          password,
          returnTo: `/auth/signup/complete?plan=${plan}`
        },
        supabaseSignup
      });

      if (!result.ok) {
        button.disabled = false;
        button.textContent = 'Continuar';
        if (errorEl) {
          errorEl.textContent = result.error ?? 'No pudimos registrar la cuenta. Verificá los datos.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      sessionStorage.setItem('orvel.signup.plan', plan);
      window.location.href = result.redirectTo ?? `/auth/signup/complete?plan=${plan}`;
    });

    document.getElementById('googleSignupBtn')?.addEventListener('click', async () => {
      const { loginWithGoogle } = await import('../../../lib/auth-provider');
      sessionStorage.setItem('orvel.signup.plan', plan);
      const secureCookie = window.location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `orvel.oauth.signup.plan=${encodeURIComponent(plan)}; Max-Age=600; Path=/; SameSite=Lax${secureCookie}`;
      const redirectUrl = new URL(`/auth/signup/business-type?plan=${plan}`, window.location.origin).toString();
      const result = await loginWithGoogle({ redirectTo: redirectUrl, plan });
      if (!result.ok) {
        const errorEl = document.getElementById('signupError');
        if (errorEl) {
            errorEl.textContent = result.error ?? 'OAuth no disponible';
            errorEl.classList.remove('hidden');
        }
      }
    });

  }
</script>
