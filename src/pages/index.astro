---
import Layout from '../layouts/Layout.astro';
import { getActivePlans, calculateBillingPrices, getPlanButtonLabel, createSubscription } from '../lib/plans';

// Import all organisms
import Header from '../components/organisms/Header.astro';
import Hero from '../components/organisms/Hero.astro';
import Features from '../components/organisms/Features.astro';
import Problem from '../components/organisms/Problem.astro';
import Solution from '../components/organisms/Solution.astro';
import HowItWorks from '../components/organisms/HowItWorks.astro';
import Differential from '../components/organisms/Differential.astro';
import Results from '../components/organisms/Results.astro';
import Audience from '../components/organisms/Audience.astro';
import Pricing from '../components/organisms/Pricing.astro';
import FAQ from '../components/organisms/FAQ.astro';
import CTA from '../components/organisms/CTA.astro';
import Footer from '../components/organisms/Footer.astro';

// Fetch plans server-side from Supabase
let plans = await getActivePlans();

// Calculate billing prices for each plan
const plansWithBilling = plans.map(p => calculateBillingPrices(p));
---

<script define:vars={{ plansData: plansWithBilling }}>
// Store plans data for client-side use
const PLANS_DATA = plansData;

// Billing toggle state
let currentBillingPeriod = 'monthly';

// Update prices based on billing period
function updatePrices(period) {
  currentBillingPeriod = period;
  
  // Update button states
  document.querySelectorAll('.billing-option').forEach(btn => {
    if (btn.dataset.billing === period) {
      btn.classList.add('bg-primary', 'text-on-secondary');
      btn.classList.remove('text-text-primary');
    } else {
      btn.classList.remove('bg-primary', 'text-on-secondary');
      btn.classList.add('text-text-primary');
    }
  });

  // Update all price displays
  document.querySelectorAll('.plan-card').forEach(card => {
    const planCode = card.dataset.planCode;
    const plan = PLANS_DATA.find(p => p.code === planCode);
    if (!plan) return;

    // Hide FREE plan if not monthly
    if (planCode === 'FREE') {
      if (period !== 'monthly') {
        card.classList.add('hidden');
      } else {
        card.classList.remove('hidden');
      }
      return;
    }

    let price = 0;
    let savings = 0;
    let billingLabel = '';

    switch (period) {
      case 'monthly':
        price = plan.price;
        billingLabel = '/mes';
        break;
      case 'quarterly':
        price = plan.quarterly_price;
        billingLabel = '/trimestre';
        savings = (plan.price * 3) - plan.quarterly_price;
        break;
      case 'annual':
        price = plan.annual_price;
        billingLabel = '/año';
        savings = (plan.price * 12) - plan.annual_price;
        break;
    }

    const priceEl = card.querySelector('.price-value');
    const labelEl = card.querySelector('.price-label');
    const savingsEl = card.querySelector('.price-savings');
    const savingsAmountEl = card.querySelector('.savings-amount');

    if (priceEl) priceEl.textContent = price;
    if (labelEl) labelEl.textContent = billingLabel;
    
    if (savings > 0 && savingsEl && savingsAmountEl) {
      savingsAmountEl.textContent = savings;
      savingsEl.classList.remove('hidden');
    } else if (savingsEl) {
      savingsEl.classList.add('hidden');
    }
  });
}

// El manejo de selección de plan y auth fue removido para pre-lanzamiento.
// La interacción se limita puramente a la visualización de los precios de forma informativa.

// Initialize billing toggle
document.addEventListener('DOMContentLoaded', () => {
  updatePrices('monthly');

  // Billing toggle handlers
  document.querySelectorAll('.billing-option').forEach(btn => {
    btn.addEventListener('click', () => {
      updatePrices(btn.dataset.billing);
    });
  });

});
</script>

<Layout title="Orvel - Probalo hoje No necesitás aprender nada.">
  <Header />
  <Hero />
  <Features />
  <Problem />
  <Solution />
  <HowItWorks />
  <Differential />
  <Results />
  <Audience />
  <Pricing plansWithBilling={plansWithBilling} />
  <FAQ />
  <!-- <CTA /> -->
  <Footer />
</Layout>