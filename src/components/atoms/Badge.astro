---
// Atom: Badge
interface Props {
  variant?: 'default' | 'secondary' | 'error' | 'success';
  class?: string;
}

const {
  variant = 'default',
  class: className = ''
} = Astro.props;

const baseClasses = 'inline-block px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase';

const variantClasses = {
  default: 'border border-border bg-white/5 text-text-primary',
  secondary: 'border border-primary/20 bg-primary/5 text-primary',
  error: 'border border-error/20 bg-error/5 text-error',
  success: 'border border-green-500/20 bg-green-500/5 text-green-500'
};

const classes = `${baseClasses} ${variantClasses[variant]}`;
---

<span class:list={[classes, className]}>
  <slot />
</span>