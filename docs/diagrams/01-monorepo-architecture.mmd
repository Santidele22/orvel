    Visitante(("<b>Visitante</b><br/>landing visitor<br/>signup via Astro")):::persona
    Cliente(("<b>Cliente</b><br/>end customer<br/>mobile browser<br/>/booking/:slug")):::persona
    Operador(("<b>Operador</b><br/>business admin<br/>dashboard PWA<br/>walk-in + turnos")):::persona

    SMTP["<b>SMTP</b> (external)<br/>LIMITED — signup email confirm only<br/>(PR-c3 confirm-email.ts)<br/>no transactional · no outbox"]:::externalLimited
    Vercel["<b>Vercel</b> (external, 3 tracks)<br/>Production · QA · Preview<br/>root vercel.json build:vercel"]:::external

    subgraph ORVEL["ORVEL — target post-release-2.0"]
        direction LR
        Landing["<b>Landing</b> (apps/landing)<br/>Astro 6.4.7 SSR + Svelte islands<br/>output: 'server' · @astrojs/vercel 10<br/>Tailwind v4<br/>Marketing + plan select + signup intent"]:::landing
        Dashboard["<b>Dashboard</b> (apps/dashboard)<br/>Angular 21.2.x PWA<br/>@angular/service-worker 21.2.18<br/>Tailwind v3 · Vitest 4<br/>SQLite local fallback (Phase 4)<br/>start_url /dashboard/turnos<br/>scope /dashboard/<br/>display standalone · maskable 512<br/>PWA Fase 1+2 shipped (c1127a0)<br/>PWA Fase 3+4 included:<br/>· IDB walk-in queue + flush<br/>· Collision policy · queue UI pill<br/>· Playwright iPhone/Pixel · Lighthouse CI ≥ 0.90"]:::dashboard

        subgraph SUPABASE["Supabase target — single-tenant MVP"]
            direction LR
            Auth["<b>Auth</b><br/>JWT issuer<br/>email/password + magic link<br/>RLS: (select auth.uid()) = created_by<br/>TO authenticated"]:::supabaseChip
            Postgres["<b>Postgres</b> (5 tablas target)<br/>business_types · services<br/>professionals · professional_services<br/>business_settings (singleton id=1)<br/>+ bookings/appointments deferred to sdd-apply<br/>+ walkin_intents ledger (PWA Fase 3)"]:::supabaseChip
            Storage["<b>Storage + Realtime</b><br/>buckets + channels"]:::supabaseChip
            EdgeFn["<b>Edge Functions (Deno) · 12 fns target</b><br/><b>Real (3):</b><br/>create-session-handoff<br/>redeem-session-handoff<br/>appointment-reminders-24h<br/><b>Coming (PR-c3, not merged):</b><br/>confirm-email<br/><b>501 OUT_OF_MVP stubs (8):</b><br/>PR #208 stubbed MP/billing surface<br/>(full enumeration in verify report)<br/>NO billing · NO MP · NO outbox"]:::supabaseEdge
        end

        subgraph MULTIPROF["Multi-profesional modeling (NUEVO)"]
            direction LR
            MultiProf["<b>professionals</b> + <b>professional_services</b><br/>N:M con composite PK<br/>business_settings.auto_assign_professional<br/>FK a bookings (cuando sdd-apply lo defina)"]:::supabaseEdge
        end

        CICD["<b>CI/CD (GitHub Actions) · 3-env target</b><br/>5 workflows + promotion workflow<br/>booking-regression.yml · ci.yml<br/>deploy-promotion.yml · account-closure.yml<br/>+ mobile-regressions (Fase 4)<br/>Required checks:<br/>· dashboard-booking-regressions<br/>· dashboard-mobile-regressions (Fase 4)"]:::cicd
        PackagesShared["<b>packages/shared</b><br/>reserved, not yet populated<br/>(only .gitkeep)"]:::reserved
    end

