---
// Organism: Hero Section
// Displays the main value proposition and primary CTA
---

<section
    class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden bg-bg-primary"
>
    <div
        class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/5 to-transparent pointer-events-none"
    >
    </div>
    <div
        class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-bg-primary via-transparent to-transparent z-10"
    >
    </div>

    <div class="landing-container relative z-20">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <!-- Content Column -->
            <div class="space-y-8 relative z-10">
                <div
                    class="landing-eyebrow border border-primary/20 bg-primary/5 text-primary shadow-sm"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-primary"
                        ></span>
                    </span>
                  Nueva versión disponible
                </div>

                <h1
                    class="font-headline font-black text-text-primary reveal"
                    style="font-size: var(--text-hero-title); line-height: 1.02; letter-spacing: -0.055em;"
                >
                    Gestioná tu salón <br />
                    <span class="text-primary italic font-light"
                        >con intención.</span
                    >
                </h1>

                <p
                    class="landing-lead text-text-secondary font-body reveal stagger-1"
                >
                    Más que una agenda, Orvel es la plataforma para profesionales
                    que buscan excelencia en cada turno y fidelidad en cada
                    cliente.
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 pt-2 reveal stagger-2">
                    <a
                        href="/auth/signup/plan"
                        class="w-full sm:w-auto btn btn-primary py-4 px-10 text-xs tracking-widest uppercase shadow-xl shadow-primary/20"
                    >
                        Empezar ahora
                    </a>
                    <a
                        href="/media/orvel-dashboard-tutorial-b.mp4"
                        data-tutorial-open
                        aria-haspopup="dialog"
                        aria-controls="tutorial-dialog"
                        target="_blank"
                        rel="noopener"
                        class="w-full sm:w-auto btn btn-secondary py-4 px-10 text-xs tracking-widest uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
                    >
                        <i class="ri-play-circle-line mr-2 text-base" aria-hidden="true"></i>
                        Ver tutorial
                    </a>
                </div>


                <div class="pt-8 border-t border-border/50">
                    <p class="text-text-primary font-serif text-2xl tracking-wide reveal stagger-3 leading-relaxed">
                        El <span class="text-primary italic relative inline-block">
                            nuevo estándar
                            <svg class="absolute w-full h-2 -bottom-1 left-0 text-primary opacity-80" viewBox="0 0 100 10" preserveAspectRatio="none">
                                <path d="M0,5 Q25,8 50,4 T100,6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
                            </svg>
                        </span> para gestionar salones <span class="text-primary italic">modernos.</span>
                    </p>
                </div>
            </div>

            <!-- Image Column -->
            <div class="relative lg:block hidden reveal-right stagger-3 scale-110 lg:scale-[1.15] lg:translate-x-12 xl:translate-x-16">
                <div
                    class="absolute inset-0 bg-primary/20 blur-[100px] rounded-full scale-75 opacity-50"
                >
                </div>
                <div
                    class="relative rounded-2xl border border-white/10 bg-bg-secondary/40 backdrop-blur-sm p-4 shadow-2xl overflow-hidden group"
                >
                    <img
                        src="/banner1.png"
                        alt="Orvel Dashboard Preview"
                        loading="eager"
                        fetchpriority="high"
                        decoding="sync"
                        class="rounded-lg w-full shadow-2xl transition-transform duration-700 group-hover:scale-[1.02]"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-tr from-primary/10 via-transparent to-transparent pointer-events-none"
                    >
                    </div>
                </div>

                <!-- Floating Elements -->
                <div
                    class="absolute -bottom-6 -left-6 bg-bg-secondary border border-border p-4 rounded-xl shadow-xl animate-float max-w-[200px]"
                >
                    <div class="flex items-center gap-3 mb-2">
                        <div
                            class="w-8 h-8 rounded-full bg-success/20 text-success flex items-center justify-center"
                        >
                            <i class="ri-check-line"></i>
                        </div>
                        <p
                            class="text-[10px] font-bold uppercase tracking-widest text-text-primary"
                        >
                            Turno Confirmado
                        </p>
                    </div>
                    <p class="text-xs text-text-secondary">
                        Peluquería "La Corte" — 15:30hs
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<dialog
    id="tutorial-dialog"
    data-tutorial-dialog
    aria-labelledby="tutorial-title"
    aria-describedby="tutorial-description"
    class="tutorial-dialog m-auto h-auto max-h-[92dvh] w-[min(94vw,72rem)] overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary p-0 text-text-primary shadow-2xl backdrop:bg-bg-primary/85 backdrop:backdrop-blur-sm"
>
    <div class="grid max-h-[92dvh] min-h-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden rounded-2xl">
        <header class="flex items-start justify-between gap-6 border-b border-border px-5 py-4 sm:px-6">
            <div>
                <h2 id="tutorial-title" class="text-lg font-bold sm:text-xl">Conocé Orvel en un minuto</h2>
                <p id="tutorial-description" class="mt-1 text-sm text-text-secondary">
                    Mirá cómo ordenás tus turnos y recuperás el control de tu día.
                </p>
            </div>
            <button
                type="button"
                data-tutorial-close
                aria-label="Cerrar tutorial"
                class="flex size-10 shrink-0 items-center justify-center rounded-full border border-border bg-bg-primary/60 text-xl text-text-primary transition hover:border-primary/60 hover:text-primary active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
                <i class="ri-close-line" aria-hidden="true"></i>
            </button>
        </header>
        <div class="relative flex min-h-0 items-center justify-center overflow-auto bg-black">
            <video
                data-tutorial-video
                data-src="/media/orvel-dashboard-tutorial-b.mp4"
                class="block h-auto max-h-full w-full bg-black object-contain"
                poster="/media/orvel-dashboard-tutorial-b-poster.webp"
                controls
                playsinline
                preload="none"
            >
                <track
                    kind="captions"
                    srclang="es"
                    label="Español"
                    src="/media/orvel-dashboard-tutorial-b.es.vtt"
                    default
                />
                Tu navegador no puede reproducir este video.
            </video>
            <div
                data-tutorial-error
                role="alert"
                aria-live="assertive"
                class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-bg-primary/95 p-6 text-center"
                hidden
            >
                <p data-tutorial-error-message class="max-w-md text-sm text-text-primary"></p>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <button type="button" data-tutorial-retry class="btn btn-primary">Reintentar</button>
                    <a
                        data-tutorial-fallback
                        href="/media/orvel-dashboard-tutorial-b.mp4"
                        target="_blank"
                        rel="noopener"
                        class="btn btn-secondary"
                    >
                        Abrir video directamente
                    </a>
                </div>
            </div>
        </div>
    </div>
</dialog>

<script>
    import { initTutorialDialog } from '../../lib/tutorial-dialog';

    initTutorialDialog();
</script>

<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
    .animate-float {
        animation: float 4s ease-in-out infinite;
    }

    .tutorial-dialog {
        opacity: 0;
        transform: translateY(0.75rem) scale(0.985);
        transition:
            opacity 180ms cubic-bezier(0.16, 1, 0.3, 1),
            transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
            overlay 180ms allow-discrete,
            display 180ms allow-discrete;
    }

    .tutorial-dialog[open] {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    [data-tutorial-error][hidden] {
        display: none;
    }

    @starting-style {
        .tutorial-dialog[open] {
            opacity: 0;
            transform: translateY(0.75rem) scale(0.985);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-float {
            animation: none;
        }

        .tutorial-dialog,
        .tutorial-dialog[open] {
            transform: none;
            transition: none;
        }
    }
</style>
