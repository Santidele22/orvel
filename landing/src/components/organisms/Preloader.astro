---
// Organism: Preloader (Skeleton Screen)
// Shows a skeleton structure of the Hero/Header until the page is fully loaded.
---

<div id="orvel-skeleton-loader" class="fixed inset-0 z-[100] bg-bg-primary flex flex-col transition-opacity duration-700 ease-in-out">
  
  <!-- Skeleton Header -->
  <header class="w-full h-16 border-b border-border/50 flex items-center justify-between px-6 md:px-12 shrink-0">
    <!-- Logo Skeleton -->
    <div class="w-24 h-8 bg-white/5 rounded-md animate-pulse"></div>
    
    <!-- Nav Skeleton (Desktop) -->
    <div class="hidden md:flex items-center space-x-8">
      <div class="w-20 h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 100ms"></div>
      <div class="w-20 h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 150ms"></div>
      <div class="w-20 h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 200ms"></div>
      <div class="w-20 h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 250ms"></div>
    </div>

    <!-- Nav Skeleton (Mobile) -->
    <div class="md:hidden w-8 h-8 bg-white/5 rounded animate-pulse"></div>
  </header>

  <!-- Skeleton Hero -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-8 md:px-12 relative flex items-center">
    <div class="grid lg:grid-cols-2 gap-16 items-center w-full">
      
      <!-- Content Column -->
      <div class="space-y-8 w-full">
        <!-- Badge -->
        <div class="w-36 h-6 bg-white/5 rounded-full animate-pulse"></div>
        
        <!-- Title -->
        <div class="space-y-3">
          <div class="w-11/12 h-12 md:h-16 bg-white/5 rounded-lg animate-pulse" style="animation-delay: 100ms"></div>
          <div class="w-3/4 h-12 md:h-16 bg-white/5 rounded-lg animate-pulse" style="animation-delay: 150ms"></div>
        </div>
        
        <!-- Paragraph -->
        <div class="space-y-2 pt-4">
          <div class="w-full h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 200ms"></div>
          <div class="w-5/6 h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 250ms"></div>
          <div class="w-4/6 h-4 bg-white/5 rounded animate-pulse" style="animation-delay: 300ms"></div>
        </div>
        
        <!-- Separator & Footer text -->
        <div class="pt-8 border-t border-border/50 mt-8">
          <div class="w-2/3 h-6 bg-white/5 rounded animate-pulse" style="animation-delay: 350ms"></div>
        </div>
      </div>

      <!-- Image Column (Desktop) -->
      <div class="hidden lg:block relative w-full aspect-square md:aspect-video lg:aspect-[4/3]">
        <div class="absolute inset-0 bg-white/5 rounded-2xl animate-pulse" style="animation-delay: 400ms"></div>
        <!-- Floating Element Skeleton -->
        <div class="absolute -bottom-6 -left-6 w-48 h-16 bg-white/10 rounded-xl animate-pulse shadow-2xl" style="animation-delay: 500ms"></div>
      </div>
      
    </div>
  </main>
</div>

<script>
  import { initPreloader } from '../../lib/preloader-controller';
  initPreloader();
</script>
