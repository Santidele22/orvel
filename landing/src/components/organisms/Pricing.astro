---
// Organism: Pricing Section
// Plans with billing toggle
interface Plan {
  code: string;
  name: string;
  price: number;
  quarterly_price: number;
  annual_price: number;
  duration_days: number;
  is_featured: boolean;
  description?: string;
}

interface Props {
  plansWithBilling: Plan[];
}

const { plansWithBilling } = Astro.props;

import PlanCard from '../molecules/PlanCard.astro';
---

<section class="relative overflow-hidden landing-section bg-bg-primary" id="pricing">
  <div class="absolute inset-x-0 top-24 mx-auto h-72 w-72 rounded-full bg-primary/10 blur-[110px] pointer-events-none"></div>
  <div class="landing-container relative z-10">
    <div class="text-center mb-12 md:mb-14">
      <div class="landing-eyebrow border border-primary/20 bg-primary/5 text-primary mb-4 shadow-sm">Precios claros</div>
      <h2 class="landing-title font-headline font-bold text-text-primary mb-4">Llená tu agenda sin esfuerzo</h2>
      <p class="landing-lead text-text-secondary mx-auto">Más turnos, menos cancelaciones. El MVP incluye un local principal; Premium suma turnos ilimitados.</p>
    </div>
    
    <div class="flex flex-col md:flex-row flex-wrap justify-center items-stretch gap-5 lg:gap-6">
      {plansWithBilling.map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

  </div>
</section>
