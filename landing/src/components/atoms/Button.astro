---
// Atom: Button
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'glass';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const baseClasses = 'inline-block font-headline font-bold text-sm py-4 px-8 rounded-full transition-all hover:scale-105 active:scale-95 shadow-lg cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100';

const variantClasses = {
  primary: 'bg-gradient-to-r from-primary to-primary-hover text-on-secondary hover:shadow-[0_0_15px_rgba(162,207,203,0.3)]',
  secondary: 'bg-primary text-on-secondary px-8 py-4 rounded-full font-headline font-bold text-lg hover:scale-105 hover:shadow-[0_0_20px_rgba(162,207,203,0.4)] transition-all flex items-center justify-center gap-2',
  outline: 'border border-border text-text-primary hover:bg-white/5',
  glass: 'glass-panel bg-white/5 border border-border hover:bg-white/10'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;

const Tag = href ? 'a' : 'button';
---

{href ? (
  <a href={href} class:list={[classes]} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} disabled={disabled} class:list={[classes]} {...rest}>
    <slot />
  </button>
)}