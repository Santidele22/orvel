{
  "name": "orvel",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "config": {
    "supabaseCliVersion": "2.98.2"
  },
  "scripts": {
    "build": "pnpm run build:dashboard && pnpm run build:dashboard-web && pnpm run build:landing",
    "build:dashboard": "pnpm --dir apps/dashboard run build",
    "build:dashboard-web": "pnpm --dir apps/dashboard-web run build",
    "build:dashboard:bun": "bun run --cwd apps/dashboard build",
    "build:landing": "pnpm --dir apps/landing run build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "check": "pnpm run test:promotion-drift && pnpm run test:core && pnpm run test:dashboard:parity:unit && pnpm run check:dashboard && pnpm run check:dashboard-web && pnpm run check:landing && pnpm run test:supabase:functions:critical && pnpm run supabase:functions:check && pnpm run test:supabase:trial-reminder:ci && pnpm run test:dashboard:parity",
    "check:dashboard": "pnpm run test:dashboard:time-picker && pnpm run test:dashboard:contracts && pnpm --dir apps/dashboard run build",
    "check:dashboard-web": "pnpm run test:dashboard-web && pnpm --dir apps/dashboard-web run build && node scripts/check-dashboard-web-pwa-artifacts.mjs",
    "check:dashboard:bun": "bun run --cwd apps/dashboard build",
    "check:landing": "pnpm run test:landing:tutorial && pnpm run test:landing:build-lock && pnpm run test:landing:no-durable-credentials && pnpm --dir apps/landing run build",
    "security:audit:prod": "pnpm audit --prod",
    "supabase:dry-run": "supabase db lint --local",
    "test:supabase:trial-reminder": "pnpm run test:supabase:trial-reminder:static && pnpm run test:supabase:trial-reminder:postgres",
    "test:supabase:trial-reminder:static": "node --test supabase/checks/20260710210000_one_time_trial_reminder_attempt.contract.test.mjs supabase/checks/20260712213000_generic_one_time_email_contract.contract.test.mjs",
    "test:supabase:trial-reminder:postgres": "bash supabase/checks/20260712190000_normalize_legacy_reminder_function_acl.test.sh && bash supabase/checks/20260712213000_generic_one_time_email_contract.test.sh && bash supabase/checks/20260710210000_one_time_trial_reminder_concurrency.sh && bash supabase/checks/20260710210000_one_time_trial_reminder_preflight.test.sh",
    "test:supabase:trial-reminder:ci": "pnpm run test:supabase:trial-reminder:operational && bash scripts/run-trial-reminder-postgres-check.sh",
    "supabase:functions:check": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test:supabase:functions:critical": "node scripts/check-focused-tests.mjs && deno test --allow-read --config supabase/functions/deno.json supabase/functions/_shared/account-closure-consumer.test.ts supabase/functions/_shared/cancel-subscription-behavior.test.ts supabase/functions/_shared/trial-user-activation-reminder.test.ts",
    "test:dashboard:account-cancellation": "node scripts/check-focused-tests.mjs && pnpm --dir apps/dashboard exec vitest run src/app/tests/integration/account-cancellation-modal.contract.spec.ts src/app/tests/integration/configuracion-zen-ui-regression-guards.contract.spec.ts src/app/tests/unit/billing-subscription-page.contract.spec.ts",
    "dev:dashboard:proxy": "pnpm --dir apps/dashboard exec node scripts/generate-dashboard-env.mjs && pnpm --dir apps/dashboard exec ng serve --host 127.0.0.1 --port 4200 --serve-path /dashboard",
    "dev:dashboard-web:proxy": "pnpm --dir apps/dashboard-web exec node ../dashboard/scripts/generate-dashboard-env.mjs && pnpm --dir apps/dashboard-web exec ng serve --host 127.0.0.1 --port 4300",
    "serve:dashboard:dist": "node scripts/serve-dashboard-dist.mjs --app dashboard --port 4400",
    "serve:dashboard-web:dist": "node scripts/serve-dashboard-dist.mjs --app dashboard-web --port 4401",
    "dev:landing:proxy": "pnpm --dir apps/landing exec astro dev --host 127.0.0.1 --port 4321",
    "dev:local-proxy": "node scripts/local-dev-proxy.mjs",
    "dev:all": "concurrently -n proxy,dashboard,landing -c blue,green,magenta --kill-others-on-fail \"pnpm run dev:local-proxy\" \"pnpm run dev:dashboard:proxy\" \"pnpm run dev:landing:proxy\"",
    "design:install": "pnpm dlx impeccable install",
    "design:update": "pnpm dlx impeccable update",
    "design:check": "pnpm dlx impeccable check",
    "design:detect": "pnpm dlx impeccable detect apps/",
    "skills:install": "pnpm run skills:install:taste && pnpm run skills:install:huashu && pnpm run skills:install:uiux && pnpm run design:install",
    "skills:install:taste": "pnpm dlx skills add https://github.com/Leonxlnx/taste-skill --skill design-taste-frontend",
    "skills:install:huashu": "pnpm dlx skills add alchaincyf/huashu-design",
    "skills:install:uiux": "pnpm dlx uipro-cli init --ai opencode",
    "skills:update:uiux": "pnpm dlx uipro-cli update",
    "playwright:init": "pnpm create playwright",
    "playwright:install": "pnpm exec playwright install --with-deps",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:seam": "pnpm exec playwright test --config playwright.seam.config.ts",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:report": "pnpm exec playwright show-report",
    "test:local-proxy": "node --test scripts/local-dev-proxy.test.mjs",
    "test:promotion-drift": "node --test scripts/check-migration-drift.test.mjs",
    "test:dashboard": "pnpm --dir apps/dashboard run test",
    "test:dashboard-web": "pnpm --dir apps/dashboard-web run test",
    "test:core": "pnpm --dir packages/dashboard-core run test",
    "test:dashboard:parity:unit": "node --test scripts/check-dashboard-failure-parity.test.mjs",
    "test:dashboard:parity": "node scripts/check-dashboard-failure-parity.mjs",
    "test:dashboard:parity:update": "node scripts/check-dashboard-failure-parity.mjs --update",
    "test:dashboard:bun": "bun run --cwd apps/dashboard test",
    "test:landing": "pnpm --dir apps/landing run test",
    "test:supabase:trial-reminder:operational": "node --test scripts/trial-reminder-*.test.mjs",
    "trial-reminder:production": "scripts/trial-reminder-production-launcher.mjs",
    "test:dashboard:time-picker": "pnpm --dir apps/dashboard exec vitest run src/app/tests/integration/configuracion-time-picker-modal-accessibility.contract.spec.ts",
    "test:dashboard:contracts": "pnpm --dir apps/dashboard exec vitest run src/app/tests/unit/dashboard-environment-source.contract.spec.ts src/app/tests/unit/generate-dashboard-env.script.spec.ts src/app/tests/unit/deploy-promotion-workflow.contract.spec.ts src/app/tests/unit/vercel-output-security-headers.contract.spec.ts",
    "test:landing:tutorial": "pnpm --dir apps/landing exec vitest run src/tests/hero-tutorial-dialog.contract.spec.ts",
    "test:landing:build-lock": "pnpm --dir apps/landing exec vitest run src/tests/landing-build-idempotency.contract.spec.ts",
    "test:landing:no-durable-credentials": "pnpm --dir apps/landing exec vitest run src/tests/no-durable-credential-store.contract.spec.ts"
  },
  "workspaces": [
    "apps/landing",
    "apps/dashboard",
    "apps/dashboard-web",
    "apps/shared/*",
    "packages/*"
  ],
  "overrides": {
    "@angular/core": "21.2.24",
    "brace-expansion": "5.0.6",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "path-to-regexp": "6.3.0",
    "tar": "7.5.22",
    "vite": "7.3.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract",
    "sharp"
  ],
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.4",
    "supabase": "2.117.0"
  }
}
