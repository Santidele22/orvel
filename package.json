{
  "name": "orvel",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "pnpm run build:dashboard && pnpm run build:landing",
    "build:dashboard": "pnpm --dir apps/dashboard run build",
    "build:dashboard:bun": "bun run --cwd apps/dashboard build",
    "build:landing": "pnpm --dir apps/landing run build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "check": "pnpm run check:dashboard && pnpm run check:landing && pnpm run supabase:functions:check",
    "check:dashboard": "pnpm --dir apps/dashboard run build",
    "check:dashboard:bun": "bun run --cwd apps/dashboard build",
    "check:landing": "pnpm --dir apps/landing run build",
    "security:audit:prod": "pnpm audit --prod",
    "supabase:dry-run": "supabase db lint --local",
    "supabase:functions:check": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "dev:dashboard:proxy": "pnpm --dir apps/dashboard exec ng serve --host 127.0.0.1 --port 4200 --serve-path /dashboard",
    "dev:landing:proxy": "pnpm --dir apps/landing exec astro dev --host 127.0.0.1 --port 4321",
    "dev:local-proxy": "node scripts/local-dev-proxy.mjs",
    "test:local-proxy": "node --test scripts/local-dev-proxy.test.mjs",
    "test:dashboard": "pnpm --dir apps/dashboard run test",
    "test:dashboard:bun": "bun run --cwd apps/dashboard test",
    "test:landing": "pnpm --dir apps/landing run test"
  },
  "workspaces": [
    "apps/landing",
    "apps/dashboard"
  ]
}
