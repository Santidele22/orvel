{
  "$schema": "https://openapi.tyrion.ai/vercel-schema.json",
  "projects": [
    {
      "name": "orvel-landing",
      "framework": "astro",
      "directory": "landing",
      "buildCommand": "pnpm --dir landing build",
      "outputDirectory": ".vercel/output",
      "env": {
        "SUPABASE_URL": "@supabase-url",
        "SUPABASE_ANON_KEY": "@supabase-anon-key"
      }
    },
    {
      "name": "orvel-dashboard",
      "framework": "custom",
      "directory": "dashboard",
      "buildCommand": "bun --dir dashboard run build",
      "outputDirectory": "dist",
      "env": {
        "SUPABASE_URL": "@supabase-url",
        "SUPABASE_ANON_KEY": "@supabase-anon-key"
      }
    }
  ]
}